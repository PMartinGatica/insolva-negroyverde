---
---

<div
  id="cookie-banner"
  class="cookie-banner hidden"
  role="dialog"
  aria-label="Aviso de cookies"
  aria-modal="false"
>
  <p class="cookie-text">
    Usamos cookies para mejorar tu navegación.
    <a href="/politica-de-privacidad/" class="cookie-link">Más info</a>
  </p>
  <div class="cookie-actions">
    <button id="cookie-reject" type="button" class="cookie-btn-secondary">Rechazar</button>
    <button id="cookie-accept" type="button" class="cookie-btn-primary">Aceptar</button>
  </div>
</div>

<style>
/*
  Barra angosta pegada al borde inferior. Antes era un panel de tres líneas
  centrado que en mobile tapaba el botón de presupuesto del hero — el CTA
  principal de la página.
*/
.cookie-banner {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 9998; /* por debajo del botón flotante de WhatsApp */
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 0.5rem 1.25rem;
  background: rgba(10, 10, 10, 0.97);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border-top: 1px solid rgba(152, 198, 101, 0.25);
  padding: 0.7rem 1rem calc(0.7rem + env(safe-area-inset-bottom, 0px));
  transition: opacity 0.4s ease, transform 0.4s ease;
}

.cookie-banner.hidden {
  opacity: 0;
  transform: translateY(100%);
  pointer-events: none;
}

.cookie-text {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 0.8rem;
  line-height: 1.4;
  color: #AFB2AD;
  margin: 0;
  text-align: center;
}

.cookie-link {
  color: #98C665;
  text-decoration: underline;
  text-underline-offset: 2px;
  transition: color 0.2s;
}
.cookie-link:hover { color: #fff; }

.cookie-actions {
  display: flex;
  gap: 0.5rem;
  flex-shrink: 0;
}

.cookie-btn-primary,
.cookie-btn-secondary {
  padding: 0.45rem 1.1rem;
  border-radius: 2px;
  font-family: 'Space Grotesk', sans-serif;
  font-weight: 600;
  font-size: 0.72rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  cursor: pointer;
  transition: background 0.2s, border-color 0.2s, color 0.2s;
}

/* Texto negro sobre el verde: en blanco el contraste era ~2.2:1. */
.cookie-btn-primary {
  background: #98C665;
  color: #11140F;
  border: 1px solid #98C665;
}
.cookie-btn-primary:hover { background: #6AA03A; border-color: #6AA03A; color: #fff; }

.cookie-btn-secondary {
  background: transparent;
  color: #AFB2AD;
  border: 1px solid rgba(255,255,255,0.18);
}
.cookie-btn-secondary:hover { border-color: #98C665; color: #98C665; }
</style>

<script>
  const COOKIE_KEY = 'insolva_cookies';
  const banner = document.getElementById('cookie-banner');

  // localStorage tira excepción en modo privado y con cookies bloqueadas:
  // si no se puede leer, el banner simplemente se muestra.
  const leer = (k: string) => { try { return localStorage.getItem(k); } catch { return null; } };
  const guardar = (k: string, v: string) => { try { localStorage.setItem(k, v); } catch { /* sin persistencia */ } };

  const ocultar = () => {
    banner?.classList.add('hidden');
    setTimeout(() => banner?.remove(), 420);
  };

  if (leer(COOKIE_KEY)) {
    banner?.remove();
  } else {
    // Entra desde abajo un instante después de cargar, para no competir con
    // el hero en el primer golpe de vista.
    setTimeout(() => banner?.classList.remove('hidden'), 1200);
  }

  document.getElementById('cookie-accept')?.addEventListener('click', () => {
    guardar(COOKIE_KEY, 'accepted');
    ocultar();
  });

  document.getElementById('cookie-reject')?.addEventListener('click', () => {
    guardar(COOKIE_KEY, 'rejected');
    ocultar();
  });
</script>
