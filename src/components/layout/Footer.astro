---
import { BRAND } from '../../lib/constants';
import { SERVICIOS } from '../../lib/servicios';
import { CANAL_URL } from '../../lib/videos';
import { funnelLink } from '../../lib/funnel';

// El footer enlaza las seis páginas de servicio desde TODAS las páginas del
// sitio. Es la forma más barata de que Google las descubra y de repartirles
// autoridad interna.
const anio = new Date().getFullYear();
---

<footer class="bg-[#11140F] border-t border-white/10 on-dark">
  <div class="wrap py-16 md:py-20">

    <div class="grid grid-cols-1 gap-12 md:grid-cols-4">

      <!-- Col 1 — Marca -->
      <div>
        <a href="/" aria-label="INSOLVA Group, inicio" class="inline-block">
          <img
            src="/logo.svg"
            alt="INSOLVA Group"
            class="h-14 w-auto mb-5"
            style="filter: brightness(0) invert(1);"
            width="260"
            height="40"
          />
        </a>
        <p class="text-sm leading-relaxed max-w-xs text-[#AFB2AD]" style="font-family:'Space Grotesk',sans-serif;">
          Seguridad electrónica, automatización, redes y electricidad.<br />
          Ushuaia, Río Grande y Tolhuin. Tierra del Fuego.
        </p>
      </div>

      <!-- Col 2 — Servicios -->
      <div>
        <p class="eyebrow mb-5">SERVICIOS</p>
        <ul class="space-y-3">
          {SERVICIOS.map((serv) => (
            <li>
              <a
                href={`/${serv.slug}/`}
                class="text-sm text-[#AFB2AD] hover:text-[#98C665] transition-colors"
                style="font-family:'Space Grotesk',sans-serif;"
              >
                {serv.nav}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3 — Navegación -->
      <div>
        <p class="eyebrow mb-5">EL SITIO</p>
        <ul class="space-y-3">
          <li>
            <a href="/servicios/" class="text-sm text-[#AFB2AD] hover:text-[#98C665] transition-colors" style="font-family:'Space Grotesk',sans-serif;">
              Todos los servicios
            </a>
          </li>
          <li>
            <a href="/trabajos/" class="text-sm text-[#AFB2AD] hover:text-[#98C665] transition-colors" style="font-family:'Space Grotesk',sans-serif;">
              Trabajos realizados
            </a>
          </li>
          <li>
            <a href="/nosotros/" class="text-sm text-[#AFB2AD] hover:text-[#98C665] transition-colors" style="font-family:'Space Grotesk',sans-serif;">
              Quiénes somos
            </a>
          </li>
          <li>
            <a href="/contacto/" class="text-sm text-[#AFB2AD] hover:text-[#98C665] transition-colors" style="font-family:'Space Grotesk',sans-serif;">
              Contacto
            </a>
          </li>
          <li>
            <a href={funnelLink('footer')} target="_blank" rel="noopener noreferrer" class="text-sm text-[#AFB2AD] hover:text-[#98C665] transition-colors" style="font-family:'Space Grotesk',sans-serif;">
              Guías gratis
            </a>
          </li>
          <li>
            <a href="/politica-de-privacidad/" class="text-sm text-[#AFB2AD] hover:text-[#98C665] transition-colors" style="font-family:'Space Grotesk',sans-serif;">
              Política de privacidad
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4 — Contacto -->
      <div>
        <p class="eyebrow mb-5">CONTACTO</p>
        <ul class="space-y-3">
          <li>
            <a href={`https://wa.me/${BRAND.whatsapp}`} target="_blank" rel="noopener noreferrer"
              class="text-sm text-[#AFB2AD] hover:text-[#98C665] transition-colors"
              style="font-family:'Space Grotesk',sans-serif;"
              aria-label="Escribir a INSOLVA por WhatsApp">
              WhatsApp: {BRAND.whatsappLegible}
            </a>
          </li>
          <li>
            <a href={`mailto:${BRAND.email}`}
              class="text-sm text-[#AFB2AD] hover:text-[#98C665] transition-colors"
              style="font-family:'Space Grotesk',sans-serif;">
              {BRAND.email}
            </a>
          </li>
          <li>
            <a href={BRAND.instagramUrl} target="_blank" rel="noopener noreferrer"
              class="text-sm text-[#AFB2AD] hover:text-[#98C665] transition-colors"
              style="font-family:'Space Grotesk',sans-serif;"
              aria-label="INSOLVA en Instagram">
              Instagram: {BRAND.instagram}
            </a>
          </li>
          <li>
            <a href={CANAL_URL} target="_blank" rel="noopener noreferrer"
              class="text-sm text-[#AFB2AD] hover:text-[#98C665] transition-colors"
              style="font-family:'Space Grotesk',sans-serif;"
              aria-label="INSOLVA en YouTube">
              YouTube: @insolva
            </a>
          </li>
        </ul>
      </div>

    </div>

    <div class="border-t border-white/10 mt-14 pt-8 flex flex-col sm:flex-row items-center justify-between gap-3">
      <!-- Antes este texto iba en #4E514A sobre #11140F: contraste ~1.9:1,
           prácticamente ilegible. -->
      <p class="text-xs text-[#848782]" style="font-family:'Space Grotesk',sans-serif;">
        © {anio} INSOLVA Group. Todos los derechos reservados.
      </p>
      <p class="text-xs text-[#848782]" style="font-family:'Space Grotesk',sans-serif;">
        Ushuaia, Tierra del Fuego, Argentina.
      </p>
    </div>

  </div>
</footer>
