---
import { BRAND } from '../../lib/constants';
---

<footer class="bg-[#0A0A0A] border-t border-white/10">
  <div class="max-w-7xl mx-auto px-6 py-16">

    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-12">

      <!-- Col 1 — Marca -->
      <div>
        <a href="#hero" aria-label="INSOLVA Group — inicio">
          <img src="/logo.svg" alt="INSOLVA Group" class="h-10 w-auto mb-4 brightness-0 invert" width="260" height="40" />
        </a>
        <p class="text-sm leading-relaxed max-w-xs text-[#C2C1C1]" style="font-family:'enma',sans-serif;">
          Agencia de ingeniería con base tecnológica.<br />{BRAND.location}.
        </p>
      </div>

      <!-- Col 2 — Pilares -->
      <div>
        <p class="eyebrow mb-4 text-[#98C665]">PILARES</p>
        <ul class="space-y-3">
          <li>
            <a href="https://insolvadev.com" target="_blank" rel="noopener noreferrer"
              class="text-sm text-[#C2C1C1] hover:text-[#98C665] transition-colors"
              style="font-family:'enma',sans-serif;">
              Desarrollo & Automatización ↗
            </a>
          </li>
          <li>
            <a href="https://insolvaseguridad.com" target="_blank" rel="noopener noreferrer"
              class="text-sm text-[#C2C1C1] hover:text-[#98C665] transition-colors"
              style="font-family:'enma',sans-serif;">
              Seguridad Electrónica ↗
            </a>
          </li>
          <li>
            <a href="#pilares"
              class="text-sm text-[#C2C1C1] hover:text-[#98C665] transition-colors"
              style="font-family:'enma',sans-serif;">
              Ingeniería
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3 — Contacto -->
      <div>
        <p class="eyebrow mb-4 text-[#98C665]">CONTACTO</p>
        <ul class="space-y-3">
          <li>
            <a href={`https://wa.me/${BRAND.whatsapp}`} target="_blank" rel="noopener noreferrer"
              class="text-sm text-[#C2C1C1] hover:text-[#98C665] transition-colors"
              style="font-family:'enma',sans-serif;"
              aria-label="WhatsApp INSOLVA">
              WhatsApp: +54 9 2901 64-1452
            </a>
          </li>
          <li>
            <a href={`mailto:${BRAND.email}`}
              class="text-sm text-[#C2C1C1] hover:text-[#98C665] transition-colors"
              style="font-family:'enma',sans-serif;">
              {BRAND.email}
            </a>
          </li>
          <li>
            <a href={BRAND.instagramUrl} target="_blank" rel="noopener noreferrer"
              class="text-sm text-[#C2C1C1] hover:text-[#98C665] transition-colors"
              style="font-family:'enma',sans-serif;"
              aria-label="INSOLVA en Instagram">
              Instagram: {BRAND.instagram}
            </a>
          </li>
        </ul>
      </div>

    </div>

    <div class="border-t border-white/10 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-[#4A4A4A]" style="font-family:'enma',sans-serif;">
        © 2026 INSOLVA Group. Todos los derechos reservados.
      </p>
      <p class="text-xs text-[#4A4A4A]" style="font-family:'enma',sans-serif;">
        Ushuaia, Tierra del Fuego, Argentina.
      </p>
    </div>

  </div>
</footer>
