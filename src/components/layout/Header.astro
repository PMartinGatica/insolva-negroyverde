---
import { NAV_LINKS } from '../../lib/constants';
import { SERVICIOS } from '../../lib/servicios';
import { whatsappLink } from '../../lib/whatsapp';

interface Props {
  /** True cuando la página arranca con un hero oscuro: el logo y los links
   *  nacen en blanco y recién al hacer scroll pasan a negro sobre la barra. */
  heroOscuro?: boolean;
}
const { heroOscuro = false } = Astro.props;

const waHref = whatsappLink({ source: 'hero' });
// Se compara sin barra final de los dos lados: los href internos la llevan
// (para no pasar por un redirect) y el pathname puede venir con o sin ella.
const sinBarra = (p: string) => p.replace(/\/+$/, '') || '/';
const rutaActual = sinBarra(Astro.url.pathname);
---

<header
  id="main-nav"
  data-hero-oscuro={String(heroOscuro)}
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
>
  <div class="wrap py-4 flex items-center justify-between gap-8">

    <!-- Logo -->
    <a href="/" class="flex-shrink-0 h-8 flex items-center" aria-label="INSOLVA Group, inicio">
      <img
        id="nav-logo"
        src="/logo.svg"
        alt="INSOLVA Group"
        class="h-10 w-auto"
        width="260"
        height="40"
      />
    </a>

    <!-- Navegación -->
    <nav
      id="nav-menu"
      class="
        fixed inset-0 w-full h-dvh bg-[#11140F]/97 overflow-y-auto
        flex flex-col items-center justify-center gap-7 px-6
        -translate-y-full transition-transform duration-300
        md:static md:h-auto md:overflow-visible md:bg-transparent md:flex-row
        md:translate-y-0 md:gap-7 md:flex-1 md:justify-center md:px-0
      "
      aria-label="Navegación principal"
    >
      {NAV_LINKS.map((link) => {
        const esExterno = link.href.startsWith('http');
        const activo = !esExterno && !link.href.startsWith('/#') && sinBarra(link.href) === rutaActual;
        return (
          <a
            href={link.href}
            target={esExterno ? '_blank' : undefined}
            rel={esExterno ? 'noopener noreferrer' : undefined}
            aria-current={activo ? 'page' : undefined}
            data-nav-link
            class="nav-link text-white text-2xl hover:text-[#98C665] transition-colors duration-200 md:text-sm"
            style="font-family:'enma',sans-serif; font-weight:600; letter-spacing:0.15em; text-transform:uppercase;"
          >
            {link.label}
          </a>
        );
      })}

      <!-- Servicios desplegados en mobile: son las páginas que queremos que
           Google descubra y que la gente pueda alcanzar desde cualquier página. -->
      <ul class="md:hidden flex flex-col items-center gap-3 pt-2 border-t border-white/10 w-full max-w-xs">
        {SERVICIOS.map((serv) => (
          <li>
            <a
              href={`/${serv.slug}/`}
              data-nav-link
              class="text-[#AFB2AD] text-base hover:text-[#98C665] transition-colors"
              style="font-family:'Space Grotesk',sans-serif;"
            >
              {serv.nav}
            </a>
          </li>
        ))}
      </ul>

      <!-- CTA WhatsApp mobile -->
      <a
        href={waHref}
        target="_blank"
        rel="noopener noreferrer"
        class="md:hidden btn btn-primary mt-2"
        aria-label="Contactar por WhatsApp"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        WhatsApp
      </a>

      <!-- Cerrar menú mobile -->
      <button
        id="nav-cerrar"
        type="button"
        class="md:hidden absolute top-5 right-5 p-2 text-white hover:text-[#98C665] transition-colors"
        aria-label="Cerrar menú"
      >
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </nav>

    <!-- CTA desktop -->
    <a
      href={waHref}
      target="_blank"
      rel="noopener noreferrer"
      class="hidden md:inline-flex items-center gap-2 px-4 py-2 rounded-sm bg-[#98C665] text-[#11140F] hover:bg-[#6AA03A] hover:text-white transition-colors duration-200 flex-shrink-0"
      style="font-family:'enma',sans-serif; font-weight:600; font-size:0.75rem; letter-spacing:0.12em; text-transform:uppercase;"
      aria-label="Pedir presupuesto por WhatsApp"
    >
      <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
      Presupuesto
    </a>

    <!-- Hamburguesa -->
    <button
      id="nav-abrir"
      type="button"
      class="nav-burger md:hidden p-2 -mr-2 text-[#11140F] transition-colors hover:text-[#98C665]"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="nav-menu"
    >
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
    </button>

  </div>
</header>

<script>
  // Menú mobile. Antes vivía en atributos onclick sueltos: no cerraba con Escape,
  // no avisaba el estado a lectores de pantalla y dejaba la página scrolleando
  // por detrás del panel abierto.
  const menu = document.getElementById('nav-menu');
  const abrir = document.getElementById('nav-abrir');
  const cerrar = document.getElementById('nav-cerrar');

  const setMenu = (visible: boolean) => {
    if (!menu) return;
    menu.classList.toggle('-translate-y-full', !visible);
    menu.classList.toggle('translate-y-0', visible);
    abrir?.setAttribute('aria-expanded', String(visible));
    document.body.style.overflow = visible ? 'hidden' : '';
    if (visible) menu.querySelector<HTMLElement>('a')?.focus();
    else abrir?.focus();
  };

  abrir?.addEventListener('click', () => setMenu(true));
  cerrar?.addEventListener('click', () => setMenu(false));
  menu?.querySelectorAll('[data-nav-link]').forEach((link) =>
    link.addEventListener('click', () => setMenu(false))
  );
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && abrir?.getAttribute('aria-expanded') === 'true') setMenu(false);
  });
</script>
