---
const beneficios = [
  {
    num: "01",
    title: "PLANIFICACIÓN A MEDIDA",
    body: "No vendemos paquetes genéricos. Relevamos tu lugar y planificamos desde el plano cada instalación —eléctrica, cámaras, automatización o redes— para que inviertas justo en lo que necesitás.",
  },
  {
    num: "02",
    title: "TODO EN UN SOLO SISTEMA",
    body: "Electricidad, seguridad, automatización del hogar y redes funcionando integradas, con acceso y control desde el celular. Una sola empresa que se ocupa de todo, sin coordinar mil proveedores.",
  },
  {
    num: "03",
    title: "CALIDAD PROFESIONAL, PRECIO JUSTO",
    body: "Usamos las mismas marcas y estándares que las grandes empresas —Hikvision, Dahua, TP-Link, Starlink— con el trato directo y la ingeniería que te dan una solución de nivel sin pagar de más.",
  },
  {
    num: "04",
    title: "GENTE DE USHUAIA",
    body: "Somos de Tierra del Fuego y trabajamos acá. Nos conocés, respondemos rápido y damos garantía en equipos e instalación. Nada de call centers ni empresas que desaparecen después de cobrar.",
  },
];
---

<section class="py-24 md:py-32 bg-[#FCFDFA]">
  <div class="max-w-7xl mx-auto px-6">

    <div class="reveal mb-16 max-w-2xl">
      <p class="eyebrow mb-4">POR QUÉ INSOLVA</p>
      <h2 class="heading-section text-[#11140F]">
        Lo que dejamos<br />en cada cliente.
      </h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-12 md:gap-8">
      {beneficios.map((b, i) => (
        <div class={`reveal reveal-delay-${i + 1} relative`}>

          <!-- Número decorativo grande detrás -->
          <span
            class="absolute -top-4 -left-2 font-['Barlow_Condensed'] font-900 text-[8rem] leading-none text-[#AFB2AD]/20 select-none pointer-events-none"
            aria-hidden="true"
          >
            {b.num}
          </span>

          <!-- Contenido -->
          <div class="relative pt-12">
            <!-- Línea verde -->
            <div class="h-px bg-[#98C665] w-8 mb-6"></div>

            <h3 class="font-['Barlow_Condensed'] font-800 uppercase tracking-wider text-xl text-[#11140F] mb-4">
              {b.title}
            </h3>

            <p class="body-text">
              {b.body}
            </p>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
