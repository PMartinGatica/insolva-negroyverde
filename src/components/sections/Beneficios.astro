---
const beneficios = [
  {
    num: "01",
    title: "PLANIFICACIÓN A MEDIDA",
    body: "No vendemos paquetes genéricos. Simulamos desde el plano el tipo, la cantidad y la ubicación de cada equipo según tu escenario real, para que inviertas justo en lo que necesitás.",
  },
  {
    num: "02",
    title: "PROTECCIÓN INTEGRAL 24/7",
    body: "Cámaras, alarmas, redes y automatización del hogar funcionando juntas en un solo sistema, con acceso remoto desde el celular. Tu hogar y tu negocio protegidos, estés donde estés.",
  },
  {
    num: "03",
    title: "CALIDAD PROFESIONAL, PRECIO JUSTO",
    body: "Usamos las mismas marcas y estándares que las grandes empresas —Hikvision, Dahua, TP-Link— con el trato directo y la ingeniería que te dan una solución de nivel sin pagar de más.",
  },
];
---

<section class="py-24 md:py-32 bg-[#FFFFFF]">
  <div class="max-w-7xl mx-auto px-6">

    <div class="reveal mb-16 max-w-2xl">
      <p class="eyebrow mb-4">04 — POR QUÉ INSOLVA</p>
      <h2 class="heading-section text-[#0A0A0A]">
        Tres resultados concretos<br />que dejamos en cada cliente.
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 md:gap-8">
      {beneficios.map((b, i) => (
        <div class={`reveal reveal-delay-${i + 1} relative`}>

          <!-- Número decorativo grande detrás -->
          <span
            class="absolute -top-4 -left-2 font-['Barlow_Condensed'] font-900 text-[8rem] leading-none text-[#C2C1C1]/20 select-none pointer-events-none"
            aria-hidden="true"
          >
            {b.num}
          </span>

          <!-- Contenido -->
          <div class="relative pt-12">
            <!-- Línea verde -->
            <div class="h-px bg-[#98C665] w-8 mb-6"></div>

            <h3 class="font-['Barlow_Condensed'] font-800 uppercase tracking-wider text-xl text-[#0A0A0A] mb-4">
              {b.title}
            </h3>

            <p class="body-text">
              {b.body}
            </p>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
