---
import { GALERIA } from '../../lib/constants';
---

<section class="py-24 md:py-32 bg-[#FFFFFF]">
  <div class="max-w-7xl mx-auto px-6">
    <div class="reveal mb-16 max-w-2xl">
      <p class="eyebrow mb-4">NUESTRO TRABAJO</p>
      <h2 class="heading-section text-[#0A0A0A]">
        Manos a la obra<br />en Tierra del Fuego.
      </h2>
      <p class="body-text mt-5">
        Somos nosotros los que vamos, relevamos e instalamos. Cada cámara y cada
        sensor queda puesto a mano, probado y funcionando.
      </p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
      {GALERIA.map((g, i) => (
        <div class={`reveal reveal-delay-${(i % 3) + 1} group relative overflow-hidden rounded-sm aspect-[3/2] bg-[#0A0A0A]`}>
          <img
            src={g.image}
            alt={g.alt}
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
          <div class="absolute inset-0 ring-1 ring-inset ring-black/5 rounded-sm pointer-events-none"></div>
        </div>
      ))}
    </div>
  </div>
</section>
