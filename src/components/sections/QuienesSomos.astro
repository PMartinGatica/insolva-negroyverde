---
const diferenciales = [
  "Planificamos a medida, desde el plano — sin paquetes genéricos.",
  "Seguridad, electricidad, automatización y redes en un solo sistema.",
  "Marcas líderes (Hikvision, Dahua, TP-Link, Starlink) a precio justo.",
  "Gente de Ushuaia: respondemos rápido y damos garantía.",
];
---

<section id="nosotros" class="py-24 md:py-32 bg-[#F7F7F5]">
  <div class="max-w-3xl mx-auto px-6 text-center">
    <div class="reveal">
      <p class="eyebrow mb-4 justify-center">QUIÉNES SOMOS · POR QUÉ ELEGIRNOS</p>
      <h2 class="heading-section mb-6 text-[#0A0A0A]">
        De Ushuaia,<br />
        hecho a tu medida.
      </h2>
      <p class="body-text max-w-2xl mx-auto">
        Somos una empresa de seguridad electrónica de Tierra del Fuego. Instalamos
        cámaras, alarmas, automatización del hogar, redes e instalaciones eléctricas
        para hogares, comercios e industrias — todo a medida de tu lugar.
      </p>
    </div>

    <!-- Diferenciales (fusiona "por qué elegirnos") -->
    <ul class="reveal reveal-delay-1 mt-12 grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-4 text-left max-w-2xl mx-auto">
      {diferenciales.map((d) => (
        <li class="flex items-start gap-3 text-[#0A0A0A]" style="font-family:'Space Grotesk',sans-serif; font-size:0.95rem;">
          <svg class="mt-0.5 flex-shrink-0 text-[#98C665]" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
          <span>{d}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
