---
---

<section id="nosotros" class="py-24 md:py-32 bg-[#F7F7F5]">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">

      <!-- Texto -->
      <div class="reveal">
        <p class="eyebrow mb-4">01 — QUIÉNES SOMOS</p>
        <h2 class="heading-section mb-6 text-[#0A0A0A]">
          Ingeniería aplicada a<br />
          la seguridad electrónica.
        </h2>
        <div class="space-y-4">
          <p class="body-text">
            Somos una empresa de ingeniería especializada en seguridad electrónica en Ushuaia
            y toda Tierra del Fuego. Trabajamos con hogares, comercios, gastronomía, industrias
            y obradores que buscan proteger lo suyo con soluciones planificadas a medida.
          </p>
          <p class="body-text">
            No vendemos paquetes genéricos: planificamos desde el plano cada instalación de
            videovigilancia, redes, automatización del hogar y alarmas, con el mismo criterio de ingeniería en
            cada proyecto. Calidad profesional, precio justo.
          </p>
          <p class="body-text">
            Para desarrollo web, sistemas y crecimiento digital contamos con
            <strong class="text-[#0A0A0A] font-semibold">DevXIA</strong>, nuestra unidad de presencia digital.
          </p>
        </div>

        <!-- Pilares rápidos -->
        <div class="mt-10 grid grid-cols-3 gap-6 border-t border-[#0A0A0A]/10 pt-8">
          <div>
            <p style="font-family:'BlauerNue',sans-serif; font-weight:900; font-size:2.5rem; color:#0A0A0A; line-height:1;">4</p>
            <p class="text-sm text-[#4A4A4A] mt-1" style="font-family:'Space Grotesk',sans-serif;">Líneas de<br/>seguridad</p>
          </div>
          <div>
            <p style="font-family:'BlauerNue',sans-serif; font-weight:900; font-size:2.5rem; color:#0A0A0A; line-height:1;">TDF</p>
            <p class="text-sm text-[#4A4A4A] mt-1" style="font-family:'Space Grotesk',sans-serif;">Ushuaia,<br/>Argentina</p>
          </div>
          <div>
            <p style="font-family:'BlauerNue',sans-serif; font-weight:900; font-size:2.5rem; color:#98C665; line-height:1;">→</p>
            <p class="text-sm text-[#4A4A4A] mt-1" style="font-family:'Space Grotesk',sans-serif;">Resultados<br/>concretos</p>
          </div>
        </div>
      </div>

      <!-- Visual geométrico -->
      <div class="reveal reveal-delay-2 flex items-center justify-center">
        <div class="relative w-full max-w-md aspect-square">

          <!-- Fondo oscuro con grid -->
          <div
            class="absolute inset-0 rounded-sm bg-[#0A0A0A]"
            style="background-image: linear-gradient(rgba(152,198,101,0.08) 1px, transparent 1px), linear-gradient(90deg, rgba(152,198,101,0.08) 1px, transparent 1px); background-size: 40px 40px;"
          ></div>

          <!-- Diagrama de proceso -->
          <div class="absolute inset-0 flex flex-col items-center justify-center gap-0 p-8">
            {[
              { num: '01', label: 'RELEVAMIENTO' },
              { num: '02', label: 'DISEÑO' },
              { num: '03', label: 'EJECUCIÓN' },
              { num: '04', label: 'SEGUIMIENTO' },
            ].map((step, i) => (
              <div class="flex flex-col items-center w-full">
                <div class="flex items-center gap-4 w-full">
                  <span class="font-['Barlow_Condensed'] font-700 text-xs text-[#98C665] w-6 flex-shrink-0">{step.num}</span>
                  <div class="flex-1 border border-[#98C665]/30 rounded-sm px-4 py-3 bg-[#98C665]/5">
                    <p class="font-['Barlow_Condensed'] font-700 text-sm uppercase tracking-widest text-white">{step.label}</p>
                  </div>
                </div>
                {i < 3 && (
                  <div class="w-px h-5 bg-[#98C665]/40 ml-9"></div>
                )}
              </div>
            ))}
          </div>

          <!-- Borde verde -->
          <div class="absolute inset-0 rounded-sm border border-[#98C665]/20 pointer-events-none"></div>
        </div>
      </div>

    </div>
  </div>
</section>
