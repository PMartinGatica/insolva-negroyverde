---
import { BRAND } from '../../lib/constants';
---

<section id="calculadora" class="py-24 md:py-32 bg-[#FFFFFF] relative overflow-hidden">

  <div
    class="absolute inset-0 pointer-events-none opacity-[0.03]"
    style="background-image: linear-gradient(#0A0A0A 1px, transparent 1px), linear-gradient(90deg, #0A0A0A 1px, transparent 1px); background-size: 60px 60px;"
  ></div>

  <div class="relative max-w-3xl mx-auto px-6">

    <div class="reveal mb-12 text-center">
      <p class="eyebrow mb-4">04.5 — CALCULÁ TU AHORRO</p>
      <h2 class="heading-section text-[#0A0A0A] mb-4">
        ¿Cuánto podés ahorrar<br />automatizando tu hogar?
      </h2>
      <p class="body-text max-w-xl mx-auto">
        Subí una foto de tu factura de luz, contanos qué te gustaría automatizar y te damos
        una estimación de ahorro en 3 pasos. Es orientativo — el estudio real lo hacemos
        juntos por WhatsApp.
      </p>
    </div>

    <div class="reveal reveal-delay-1 border border-[#0A0A0A]/10 rounded-sm bg-[#F7F7F5] p-6 md:p-10">

      <!-- Barra de progreso -->
      <div class="flex items-center gap-2 mb-10" aria-hidden="true">
        {[1, 2, 3, 4].map((n) => (
          <div class={`calc-step-dot h-1 flex-1 rounded-full bg-[#0A0A0A]/10`} data-step-dot={n}></div>
        ))}
      </div>

      <!-- Paso 1: subir factura -->
      <div class="calc-step" data-step="1">
        <p class="eyebrow mb-3 text-[#98C665]">PASO 1 DE 4</p>
        <h3 class="heading-card text-[#0A0A0A] mb-2">Subí tu factura de luz</h3>
        <p class="body-text mb-6">Una foto o PDF alcanza. La leemos automáticamente para calcular tu consumo.</p>

        <label
          for="calc-file-input"
          id="calc-dropzone"
          class="
            flex flex-col items-center justify-center gap-3
            border-2 border-dashed border-[#0A0A0A]/20 rounded-sm
            py-12 px-6 cursor-pointer
            hover:border-[#98C665]/60 hover:bg-[#98C665]/5
            transition-colors duration-200
          "
        >
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-[#98C665]" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="17 8 12 3 7 8"/>
            <line x1="12" y1="3" x2="12" y2="15"/>
          </svg>
          <span class="text-sm text-[#0A0A0A]" style="font-family:'Space Grotesk',sans-serif;">
            Hacé clic o arrastrá tu factura acá
          </span>
          <span class="text-xs text-[#6b7280]">JPG, PNG o PDF · máx. 8MB</span>
          <input id="calc-file-input" type="file" accept="image/jpeg,image/png,image/webp,application/pdf" class="hidden" />
        </label>

        <p id="calc-file-status" class="text-sm text-[#98C665] mt-3 hidden"></p>
        <p id="calc-file-error" class="text-sm text-red-600 mt-3 hidden"></p>

        <div class="mt-6 flex justify-between items-center">
          <button type="button" class="calc-skip text-sm text-[#6b7280] hover:text-[#0A0A0A] underline underline-offset-2" data-goto="2">
            Prefiero cargar el consumo manualmente
          </button>
        </div>
      </div>

      <!-- Paso 1b: consumo manual (fallback / confirmación) -->
      <div class="calc-step hidden" data-step="2">
        <p class="eyebrow mb-3 text-[#98C665]">PASO 2 DE 4</p>
        <h3 class="heading-card text-[#0A0A0A] mb-2">Confirmá tu consumo</h3>
        <p id="calc-consumo-msg" class="body-text mb-6">Completá o ajustá estos datos de tu factura.</p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
          <div>
            <label class="text-xs text-[#6b7280] mb-1 block" for="calc-kwh">Consumo (kWh por período)</label>
            <input id="calc-kwh" type="number" min="1" placeholder="ej. 450" class="w-full bg-white border border-[#0A0A0A]/15 rounded-sm px-3 py-2.5 text-sm focus:border-[#98C665]/60 outline-none" style="font-family:'Space Grotesk',sans-serif;" />
          </div>
          <div>
            <label class="text-xs text-[#6b7280] mb-1 block" for="calc-costo">Costo total (ARS)</label>
            <input id="calc-costo" type="number" min="1" placeholder="ej. 45000" class="w-full bg-white border border-[#0A0A0A]/15 rounded-sm px-3 py-2.5 text-sm focus:border-[#98C665]/60 outline-none" style="font-family:'Space Grotesk',sans-serif;" />
          </div>
        </div>

        <div class="mb-6">
          <p class="text-xs text-[#6b7280] mb-2">¿Qué te gustaría automatizar?</p>
          <div class="flex flex-wrap gap-2">
            {[
              { id: 'iluminacion', label: 'Iluminación' },
              { id: 'climatizacion', label: 'Climatización' },
              { id: 'accesos', label: 'Accesos y cerraduras' },
              { id: 'general', label: 'Todo el hogar/negocio' },
            ].map((opt) => (
              <button type="button" class="calc-chip" data-value={opt.id}>{opt.label}</button>
            ))}
          </div>
        </div>

        <div class="flex justify-between items-center">
          <button type="button" class="text-sm text-[#6b7280] hover:text-[#0A0A0A]" data-goto="1">← Volver</button>
          <button type="button" id="calc-continue-2" class="btn-calc-primary" data-goto="3" disabled>Continuar</button>
        </div>
      </div>

      <!-- Paso 3: email -->
      <div class="calc-step hidden" data-step="3">
        <p class="eyebrow mb-3 text-[#98C665]">PASO 3 DE 4</p>
        <h3 class="heading-card text-[#0A0A0A] mb-2">¿A dónde te mandamos el resultado?</h3>
        <p class="body-text mb-6">Dejanos tu email y tu nombre para enviarte tu estimación personalizada.</p>

        <div class="grid grid-cols-1 gap-4 mb-6">
          <div>
            <label class="text-xs text-[#6b7280] mb-1 block" for="calc-nombre">Nombre</label>
            <input id="calc-nombre" type="text" placeholder="Tu nombre" class="w-full bg-white border border-[#0A0A0A]/15 rounded-sm px-3 py-2.5 text-sm focus:border-[#98C665]/60 outline-none" style="font-family:'Space Grotesk',sans-serif;" />
          </div>
          <div>
            <label class="text-xs text-[#6b7280] mb-1 block" for="calc-email">Email</label>
            <input id="calc-email" type="email" placeholder="tu@email.com" class="w-full bg-white border border-[#0A0A0A]/15 rounded-sm px-3 py-2.5 text-sm focus:border-[#98C665]/60 outline-none" style="font-family:'Space Grotesk',sans-serif;" />
          </div>
        </div>

        <p class="text-xs text-[#6b7280] mb-6">
          No compartimos tu email con terceros. Solo lo usamos para enviarte esta estimación y,
          si querés, coordinar tu presupuesto.
        </p>

        <div class="flex justify-between items-center">
          <button type="button" class="text-sm text-[#6b7280] hover:text-[#0A0A0A]" data-goto="2">← Volver</button>
          <button type="button" id="calc-continue-3" class="btn-calc-primary" data-goto="4" disabled>Ver mi estimación</button>
        </div>
      </div>

      <!-- Paso 4: resultado -->
      <div class="calc-step hidden" data-step="4">
        <p class="eyebrow mb-3 text-[#98C665]">TU ESTIMACIÓN</p>
        <h3 class="heading-card text-[#0A0A0A] mb-6">Esto es lo que podrías ahorrar</h3>

        <div class="bg-[#0A0A0A] rounded-sm p-6 md:p-8 mb-6">
          <p class="text-xs uppercase tracking-widest text-[#98C665] mb-2" style="font-family:'Barlow_Condensed',sans-serif;">Ahorro mensual estimado</p>
          <p id="calc-resultado-monto" class="text-4xl md:text-5xl font-bold text-white mb-1" style="font-family:'BlauerNue',sans-serif;">—</p>
          <p id="calc-resultado-detalle" class="text-sm text-[#9ca3af]"></p>
        </div>

        <p class="text-xs text-[#6b7280] mb-8">
          * Estimación orientativa basada en rangos típicos de ahorro por automatización
          (no es un compromiso ni un presupuesto formal). El estudio real y personalizado
          lo armamos juntos, sin cargo, por WhatsApp.
        </p>

        <a id="calc-whatsapp-cta" href="#" target="_blank" rel="noopener noreferrer" class="btn-calc-primary w-full justify-center flex">
          Quiero mi estudio personalizado por WhatsApp
        </a>
      </div>

    </div>
  </div>
</section>

<style>
  .btn-calc-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.5rem;
    background: #98C665;
    color: #fff;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: 0.85rem;
    border-radius: 2px;
    transition: background 0.2s, opacity 0.2s;
  }
  .btn-calc-primary:hover:not(:disabled) { background: #6AA03A; }
  .btn-calc-primary:disabled { opacity: 0.4; cursor: not-allowed; }

  .calc-chip {
    padding: 0.5rem 1rem;
    font-size: 0.8rem;
    border: 1px solid rgba(10,10,10,0.15);
    border-radius: 999px;
    background: #fff;
    color: #0A0A0A;
    font-family: 'Space Grotesk', sans-serif;
    transition: all 0.2s;
  }
  .calc-chip.calc-chip-active {
    background: #98C665;
    border-color: #98C665;
    color: #fff;
  }

  .calc-step-dot.calc-step-dot-active { background: #98C665; }
</style>

<script is:inline define:vars={{ whatsappNumber: BRAND.whatsapp }}>
(function () {
  function safe(fn) {
    try { fn(); } catch (e) { console.error('[calculadora]', e); }
  }

  safe(function () {
    var steps = document.querySelectorAll('.calc-step');
    var dots = document.querySelectorAll('[data-step-dot]');
    var fileInput = document.getElementById('calc-file-input');
    var fileStatus = document.getElementById('calc-file-status');
    var fileError = document.getElementById('calc-file-error');
    var kwhInput = document.getElementById('calc-kwh');
    var costoInput = document.getElementById('calc-costo');
    var continue2Btn = document.getElementById('calc-continue-2');
    var continue3Btn = document.getElementById('calc-continue-3');
    var nombreInput = document.getElementById('calc-nombre');
    var emailInput = document.getElementById('calc-email');
    var consumoMsg = document.getElementById('calc-consumo-msg');

    if (!steps.length || !fileInput) return;

    var state = {
      kwh: null,
      costo: null,
      automatizacion: null,
      nombre: '',
      email: '',
    };

    function goToStep(n) {
      steps.forEach(function (s) {
        s.classList.toggle('hidden', s.getAttribute('data-step') !== String(n));
      });
      dots.forEach(function (d) {
        var dotStep = parseInt(d.getAttribute('data-step-dot'), 10);
        d.classList.toggle('calc-step-dot-active', dotStep <= n);
      });
    }

    document.querySelectorAll('[data-goto]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        if (btn.disabled) return;
        var target = parseInt(btn.getAttribute('data-goto'), 10);
        if (target === 4) computeResult();
        goToStep(target);
      });
    });

    // Subida de archivo -> Gemini Vision vía /api/leer-factura
    fileInput.addEventListener('change', function () {
      var file = fileInput.files && fileInput.files[0];
      if (!file) return;

      fileError.classList.add('hidden');
      fileStatus.classList.remove('hidden');
      fileStatus.textContent = 'Leyendo tu factura...';

      var reader = new FileReader();
      reader.onload = function () {
        var base64 = String(reader.result).split(',')[1];
        fetch('/api/leer-factura', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ imageBase64: base64, mimeType: file.type }),
        })
          .then(function (res) { return res.json().then(function (d) { return { ok: res.ok, data: d }; }); })
          .then(function (result) {
            if (!result.ok || result.data.legible === false) {
              fileStatus.classList.add('hidden');
              fileError.classList.remove('hidden');
              fileError.textContent = result.data.error || 'No pudimos leer bien la factura. Cargá los datos manualmente.';
              consumoMsg.textContent = 'No pudimos leer tu factura automáticamente. Completá los datos manualmente.';
              goToStep(2);
              return;
            }
            state.kwh = result.data.consumo_kwh;
            state.costo = result.data.costo_total_ars;
            if (kwhInput && state.kwh) kwhInput.value = state.kwh;
            if (costoInput && state.costo) costoInput.value = state.costo;
            fileStatus.textContent = '✓ Factura leída correctamente.';
            consumoMsg.textContent = 'Estos son los datos que leímos de tu factura. Podés ajustarlos si hace falta.';
            goToStep(2);
            validateStep2();
          })
          .catch(function () {
            fileStatus.classList.add('hidden');
            fileError.classList.remove('hidden');
            fileError.textContent = 'No pudimos conectar para leer la factura. Cargá los datos manualmente.';
            goToStep(2);
          });
      };
      reader.readAsDataURL(file);
    });

    function validateStep2() {
      var kwhVal = parseFloat(kwhInput.value);
      var costoVal = parseFloat(costoInput.value);
      var valid = !isNaN(kwhVal) && kwhVal > 0 && !isNaN(costoVal) && costoVal > 0 && !!state.automatizacion;
      continue2Btn.disabled = !valid;
      if (valid) {
        state.kwh = kwhVal;
        state.costo = costoVal;
      }
    }
    kwhInput.addEventListener('input', validateStep2);
    costoInput.addEventListener('input', validateStep2);

    document.querySelectorAll('.calc-chip').forEach(function (chip) {
      chip.addEventListener('click', function () {
        document.querySelectorAll('.calc-chip').forEach(function (c) { c.classList.remove('calc-chip-active'); });
        chip.classList.add('calc-chip-active');
        state.automatizacion = chip.getAttribute('data-value');
        validateStep2();
      });
    });

    function validateStep3() {
      var emailValid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailInput.value.trim());
      var nombreValid = nombreInput.value.trim().length >= 2;
      continue3Btn.disabled = !(emailValid && nombreValid);
      if (emailValid && nombreValid) {
        state.nombre = nombreInput.value.trim();
        state.email = emailInput.value.trim();
      }
    }
    nombreInput.addEventListener('input', validateStep3);
    emailInput.addEventListener('input', validateStep3);

    // Rangos de ahorro orientativos por tipo de automatización (fuentes: rangos típicos
    // de la industria de domótica/eficiencia energética — SIEMPRE mostrados como estimación).
    var RANGOS = {
      iluminacion: [0.05, 0.15],
      climatizacion: [0.10, 0.20],
      accesos: [0.02, 0.06],
      general: [0.12, 0.25],
    };

    function computeResult() {
      var rango = RANGOS[state.automatizacion] || RANGOS.general;
      var costo = state.costo || 0;
      var min = Math.round(costo * rango[0]);
      var max = Math.round(costo * rango[1]);

      var montoEl = document.getElementById('calc-resultado-monto');
      var detalleEl = document.getElementById('calc-resultado-detalle');
      var waCta = document.getElementById('calc-whatsapp-cta');

      montoEl.textContent = '$' + min.toLocaleString('es-AR') + ' – $' + max.toLocaleString('es-AR');
      detalleEl.textContent = 'Sobre una factura de $' + costo.toLocaleString('es-AR') + ' (' + (state.kwh || '—') + ' kWh), automatizando ' +
        (state.automatizacion === 'general' ? 'todo tu hogar/negocio' : state.automatizacion) + '.';

      var msg = 'Hola INSOLVA, soy ' + state.nombre + '. Hice la calculadora de ahorro en la web: mi factura es de $' +
        costo.toLocaleString('es-AR') + ' (' + (state.kwh || '—') + ' kWh) y me interesa automatizar ' +
        (state.automatizacion === 'general' ? 'todo mi hogar/negocio' : state.automatizacion) +
        '. Mi email es ' + state.email + '. Quiero un estudio personalizado.';

      if (waCta) {
        waCta.href = 'https://wa.me/' + whatsappNumber + '?text=' + encodeURIComponent(msg);
      }

      // Guardamos el lead apenas se calcula el resultado, sin bloquear al
      // usuario ni mostrarle errores si el guardado falla (best-effort).
      if (!state.leadGuardado) {
        state.leadGuardado = true;
        fetch('/api/guardar-lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            nombre: state.nombre,
            email: state.email,
            consumo_kwh: state.kwh,
            costo_ars: state.costo,
            automatizacion: state.automatizacion,
            ahorro_estimado_min: min,
            ahorro_estimado_max: max,
          }),
        }).catch(function () { /* best-effort: si falla, el usuario igual ve su resultado */ });
      }
    }
  });
})();
</script>
