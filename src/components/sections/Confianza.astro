---
import { CONFIANZA } from '../../lib/constants';
---

<section class="py-24 md:py-32 bg-[#0A0A0A] relative overflow-hidden">
  <!-- Grid decorativo fondo -->
  <div
    class="absolute inset-0 pointer-events-none opacity-[0.06]"
    style="background-image: linear-gradient(rgba(152,198,101,0.4) 1px, transparent 1px), linear-gradient(90deg, rgba(152,198,101,0.4) 1px, transparent 1px); background-size: 80px 80px;"
  ></div>

  <div class="relative max-w-7xl mx-auto px-6">
    <div class="reveal mb-16 max-w-2xl">
      <p class="eyebrow mb-4 text-[#98C665]">POR QUÉ ELEGIRNOS</p>
      <h2 class="heading-section text-white">
        Seguridad confiable,<br />gente de Ushuaia.
      </h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      {CONFIANZA.map((item, i) => (
        <div class={`reveal reveal-delay-${i + 1} flex flex-col gap-4`}>
          <div class="w-11 h-11 flex items-center justify-center rounded-sm bg-[#98C665]/10 text-[#98C665]">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 6 9 17l-5-5"/>
            </svg>
          </div>
          <h3 class="font-['Barlow_Condensed'] font-800 uppercase tracking-wider text-base text-white">
            {item.title}
          </h3>
          <p class="text-sm leading-relaxed text-[#9ca3af]" style="font-family:'Space Grotesk',sans-serif;">
            {item.body}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
