---
import { BRAND } from '../../lib/constants';
import { whatsappLink } from '../../lib/whatsapp';

const waHref = whatsappLink({ source: 'contacto' });
---

<section id="contacto" class="py-24 md:py-32 bg-[#0A0A0A] relative overflow-hidden">

  <!-- Grid decorativo fondo -->
  <div
    class="absolute inset-0 pointer-events-none opacity-10"
    style="background-image: linear-gradient(rgba(152,198,101,0.2) 1px, transparent 1px), linear-gradient(90deg, rgba(152,198,101,0.2) 1px, transparent 1px); background-size: 80px 80px;"
  ></div>

  <!-- Glow -->
  <div
    class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[300px] pointer-events-none"
    style="background: radial-gradient(ellipse, rgba(152,198,101,0.1) 0%, transparent 70%);"
  ></div>

  <div class="relative max-w-7xl mx-auto px-6 text-center">

    <div class="reveal">
      <p class="eyebrow mb-4 text-[#98C665]">HABLEMOS</p>
      <h2 class="heading-section text-white mb-6">
        Pedí tu presupuesto<br />
        para tu casa, negocio<br />
        u obra en Ushuaia.
      </h2>
      <p class="text-[#C2C1C1] mt-4" style="font-family:'Space Grotesk',sans-serif; font-size:1rem;">
        Te respondemos en el día. Presupuesto sin cargo y sin compromiso.
      </p>
    </div>

    <!-- CTA principal -->
    <div class="reveal reveal-delay-1 mt-12">
      <a
        href={waHref}
        target="_blank"
        rel="noopener noreferrer"
        class="
          inline-flex items-center gap-3 px-8 py-5
          bg-[#98C665] text-white
          font-['Barlow_Condensed'] font-bold uppercase tracking-wider text-lg
          hover:bg-[#6AA03A] transition-colors duration-200 rounded-sm
          shadow-lg shadow-[#98C665]/20
        "
        aria-label="Pedir presupuesto por WhatsApp a INSOLVA"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        Pedí tu presupuesto por WhatsApp
      </a>

      <p class="mt-3 text-[#C2C1C1] font-['Barlow'] text-sm">{BRAND.whatsapp.replace('549', '+54 9 ').replace(/(\d{4})(\d{2})(\d{4})$/, '$1 $2-$3')}</p>
    </div>

    <!-- Info secundaria -->
    <div class="reveal reveal-delay-2 mt-16 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 max-w-3xl mx-auto border-t border-white/10 pt-12">
      <a
        href={`tel:+${BRAND.whatsapp}`}
        class="flex flex-col items-center gap-2 text-[#C2C1C1] hover:text-[#98C665] transition-colors duration-200 group"
        aria-label="Llamar por teléfono a INSOLVA"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-[#98C665]" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
        <span class="font-['Barlow'] text-sm">Llamar</span>
      </a>

      <a
        href={`mailto:${BRAND.email}`}
        class="flex flex-col items-center gap-2 text-[#C2C1C1] hover:text-[#98C665] transition-colors duration-200 group"
        aria-label={`Enviar email a ${BRAND.email}`}
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-[#98C665]" aria-hidden="true">
          <rect x="2" y="4" width="20" height="16" rx="2"/>
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
        </svg>
        <span class="font-['Barlow'] text-sm">{BRAND.email}</span>
      </a>

      <a
        href={BRAND.instagramUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex flex-col items-center gap-2 text-[#C2C1C1] hover:text-[#98C665] transition-colors duration-200"
        aria-label={`INSOLVA en Instagram ${BRAND.instagram}`}
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-[#98C665]" aria-hidden="true">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
          <circle cx="12" cy="12" r="4"/>
          <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"/>
        </svg>
        <span class="font-['Barlow'] text-sm">{BRAND.instagram}</span>
      </a>

      <div class="flex flex-col items-center gap-2 text-[#C2C1C1]">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-[#98C665]" aria-hidden="true">
          <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
          <circle cx="12" cy="10" r="3"/>
        </svg>
        <span class="font-['Barlow'] text-sm">{BRAND.location}</span>
      </div>
    </div>

  </div>
</section>
