---
import { getProductosDestacados, TIENDA_URL } from '../../lib/tienda';

const productos = await getProductosDestacados(4);

const formatearPrecio = (precio: number) =>
  new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS', maximumFractionDigits: 0 }).format(precio);
---

{productos.length > 0 && (
  <section id="tienda" class="section section-paper">
    <div class="wrap">

      <div class="reveal mb-14 max-w-2xl">
        <p class="eyebrow mb-4">TIENDA ONLINE</p>
        <h2 class="heading-section text-[#11140F]">
          Equipá tu casa<br />con un click.
        </h2>
        <p class="body-text mt-5">
          Cámaras, cerraduras y dispositivos de automatización listos para llevar.
          Si preferís que te lo instalemos nosotros, escribinos y lo coordinamos.
        </p>
      </div>

      <div class="grid grid-cols-2 lg:grid-cols-4 gap-5 mb-12">
        {productos.map((producto, index) => (
          <a
            href={producto.href}
            target="_blank"
            rel="noopener noreferrer"
            class={`
              reveal reveal-delay-${(index % 3) + 1}
              group flex flex-col border-t border-[#11140F]/12 pt-5
              hover:border-[#98C665] transition-colors
            `}
          >
            <div class="relative w-full aspect-square overflow-hidden rounded-sm bg-[#FCFDFA] mb-4 photo-zoom">
              {producto.imagen ? (
                <img
                  src={producto.imagen}
                  alt={`${producto.nombre}, INSOLVA Group`}
                  loading="lazy"
                  decoding="async"
                  width="400"
                  height="400"
                  class="w-full h-full object-contain p-4"
                />
              ) : (
                <!-- Sin foto real cargada en WooCommerce: marcador neutro, para
                     no ilustrar un producto con la foto de otra cosa. -->
                <span class="absolute inset-0 flex items-center justify-center" aria-hidden="true">
                  <img src="/isotipo-verde.svg" alt="" width="48" height="58" class="w-10 h-auto opacity-25" />
                </span>
              )}
              {producto.badge && (
                <span
                  class="absolute top-2 left-2 px-2.5 py-1 rounded-sm bg-[#98C665] text-[#11140F] text-[0.65rem] uppercase tracking-wider"
                  style="font-family:'enma',sans-serif; font-weight:600;"
                >
                  {producto.badge}
                </span>
              )}
            </div>

            <h3
              class="text-[#11140F] text-sm leading-snug mb-2 group-hover:text-[#4F7D22] transition-colors"
              style="font-family:'Space Grotesk',sans-serif; font-weight:500;"
            >
              {producto.nombre}
            </h3>
            <p class="body-text text-sm mb-3">{producto.detalle}</p>
            <span
              class="text-[#11140F] text-base mt-auto"
              style="font-family:'Barlow Condensed',sans-serif; font-weight:600;"
            >
              {formatearPrecio(producto.precio)}
            </span>
          </a>
        ))}
      </div>

      <div class="reveal">
        <a href={TIENDA_URL} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
          Ver tienda completa
        </a>
      </div>

    </div>
  </section>
)}
