---
import { TRABAJOS } from '../../lib/constants';
import { whatsappLink } from '../../lib/whatsapp';

const waHref = whatsappLink({ source: 'contacto' });
---

<section id="trabajos" class="py-24 md:py-32 bg-[#F7F7F5]">
  <div class="max-w-7xl mx-auto px-6">
    <div class="reveal mb-16 max-w-2xl">
      <p class="eyebrow mb-4">TRABAJOS REALES</p>
      <h2 class="heading-section text-[#0A0A0A]">
        Instalaciones reales<br />en Ushuaia.
      </h2>
      <p class="body-text mt-5">
        Trabajos reales en Tierra del Fuego. Tocá cada uno para ver más fotos.
      </p>
    </div>

    <!-- 2 columnas en desktop: con 4 trabajos quedan 2+2 parejas (con 3 columnas
         la cuarta card quedaba huérfana en una fila sola). -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      {TRABAJOS.map((t, i) => (
        <button
          type="button"
          class={`trabajo-card reveal reveal-delay-${i + 1} group text-left overflow-hidden rounded-sm bg-white border border-[#0A0A0A]/8 hover:border-[#98C665]/60 transition-colors cursor-pointer`}
          data-galeria={JSON.stringify(t.galeria)}
          data-tipo={t.tipo}
          aria-label={`Ver galería de fotos — ${t.tipo}`}
        >
          <div class="relative aspect-[4/3] overflow-hidden bg-[#0F0F0F]">
            <!-- Fondo: la misma foto ampliada y desenfocada, para que las fotos
                 verticales no dejen barras negras a los costados (efecto CapCut). -->
            <img
              src={t.image}
              alt=""
              aria-hidden="true"
              loading="lazy"
              decoding="async"
              class="absolute inset-0 w-full h-full object-cover scale-110 blur-xl opacity-60"
            />
            <img
              src={t.image}
              alt={`Instalación de seguridad — ${t.tipo}`}
              loading="lazy"
              decoding="async"
              class="relative w-full h-full object-contain transition-transform duration-500 group-hover:scale-105"
            />
            <!-- Overlay "ver fotos" -->
            <div class="absolute inset-0 bg-[#0A0A0A]/0 group-hover:bg-[#0A0A0A]/30 transition-colors flex items-center justify-center">
              <span class="opacity-0 group-hover:opacity-100 transition-opacity flex items-center gap-2 px-4 py-2 rounded-sm bg-[#98C665] text-white font-['Barlow_Condensed'] font-700 uppercase tracking-wider text-xs">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>
                </svg>
                Ver fotos ({t.galeria.length})
              </span>
            </div>
          </div>
          <div class="p-5">
            <p class="font-['Barlow_Condensed'] font-800 uppercase tracking-wider text-sm text-[#0A0A0A]">
              {t.tipo}
            </p>
            <p class="text-sm text-[#4A4A4A] mt-1.5" style="font-family:'Space Grotesk',sans-serif;">
              {t.detalle}
            </p>
          </div>
        </button>
      ))}
    </div>

    <div class="reveal mt-12">
      <a
        href={waHref}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-[#0A0A0A] font-['Barlow_Condensed'] font-700 uppercase tracking-wider text-sm hover:text-[#6AA03A] transition-colors"
      >
        ¿Querés algo así en tu casa o negocio? Escribinos →
      </a>
    </div>
  </div>
</section>

<!-- ── Lightbox / carrusel ── -->
<div id="trabajo-lightbox" class="tb-overlay" role="dialog" aria-modal="true" aria-label="Galería de fotos del trabajo" hidden>
  <button type="button" id="tb-close" class="tb-btn tb-close" aria-label="Cerrar galería">
    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
  </button>

  <button type="button" id="tb-prev" class="tb-btn tb-nav tb-prev" aria-label="Foto anterior">
    <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
  </button>

  <!-- Fondo desenfocado con la foto actual: rellena el vacío alrededor de las
       fotos verticales en vez de dejar negro plano (efecto CapCut). -->
  <img id="tb-bg" class="tb-bg" src="" alt="" aria-hidden="true" />

  <div class="tb-stage">
    <img id="tb-img" src="" alt="" />
  </div>

  <button type="button" id="tb-next" class="tb-btn tb-nav tb-next" aria-label="Foto siguiente">
    <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
  </button>

  <div class="tb-caption">
    <span id="tb-tipo"></span>
    <span id="tb-counter"></span>
  </div>
</div>

<style is:global>
  .tb-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: rgba(5, 5, 5, 0.94);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .tb-overlay[hidden] { display: none; }
  .tb-overlay.tb-open { opacity: 1; }

  .tb-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.15);
    filter: blur(38px) saturate(1.1);
    opacity: 0.35;
    pointer-events: none;
    z-index: 0;
  }

  .tb-stage {
    position: relative;
    z-index: 1;
    max-width: min(1100px, 92vw);
    max-height: 82vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .tb-stage img {
    max-width: 100%;
    max-height: 82vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 3px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.5);
    user-select: none;
  }

  .tb-btn {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 999px;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
  }
  .tb-btn:hover { background: rgba(152,198,101,0.25); border-color: #98C665; }

  .tb-close { top: 1.25rem; right: 1.25rem; width: 3rem; height: 3rem; }
  .tb-nav { top: 50%; transform: translateY(-50%); width: 3.25rem; height: 3.25rem; }
  .tb-prev { left: 1.25rem; }
  .tb-next { right: 1.25rem; }

  .tb-caption {
    position: absolute;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 1rem;
    align-items: center;
    color: #e5e7eb;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.85rem;
    background: rgba(0,0,0,0.4);
    padding: 0.5rem 1rem;
    border-radius: 999px;
    white-space: nowrap;
  }
  #tb-tipo { font-weight: 600; color: #98C665; text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.75rem; }
  #tb-counter { color: #9ca3af; }

  @media (max-width: 640px) {
    .tb-nav { width: 2.75rem; height: 2.75rem; }
    .tb-prev { left: 0.5rem; }
    .tb-next { right: 0.5rem; }
    .tb-close { top: 0.75rem; right: 0.75rem; }
  }
</style>

<script is:inline>
(function () {
  var overlay = document.getElementById('trabajo-lightbox');
  var imgEl = document.getElementById('tb-img');
  var bgEl = document.getElementById('tb-bg');
  var tipoEl = document.getElementById('tb-tipo');
  var counterEl = document.getElementById('tb-counter');
  var btnClose = document.getElementById('tb-close');
  var btnPrev = document.getElementById('tb-prev');
  var btnNext = document.getElementById('tb-next');
  if (!overlay || !imgEl) return;

  var fotos = [];
  var idx = 0;
  var lastFocused = null;

  function render() {
    imgEl.src = fotos[idx];
    imgEl.alt = 'Foto ' + (idx + 1) + ' del trabajo';
    if (bgEl) bgEl.src = fotos[idx];
    counterEl.textContent = (idx + 1) + ' / ' + fotos.length;
  }

  function open(galeria, tipo) {
    fotos = galeria;
    idx = 0;
    tipoEl.textContent = tipo || '';
    render();
    overlay.hidden = false;
    // permitir que el navegador pinte antes de la transición
    requestAnimationFrame(function () { overlay.classList.add('tb-open'); });
    document.body.style.overflow = 'hidden';
    document.addEventListener('keydown', onKey);
    btnClose.focus();
  }

  function close() {
    overlay.classList.remove('tb-open');
    document.removeEventListener('keydown', onKey);
    document.body.style.overflow = '';
    setTimeout(function () { overlay.hidden = true; imgEl.src = ''; if (bgEl) bgEl.src = ''; }, 200);
    if (lastFocused) lastFocused.focus();
  }

  function next() { idx = (idx + 1) % fotos.length; render(); }
  function prev() { idx = (idx - 1 + fotos.length) % fotos.length; render(); }

  function onKey(e) {
    if (e.key === 'Escape') close();
    else if (e.key === 'ArrowRight') next();
    else if (e.key === 'ArrowLeft') prev();
  }

  btnClose.addEventListener('click', close);
  btnNext.addEventListener('click', next);
  btnPrev.addEventListener('click', prev);
  overlay.addEventListener('click', function (e) {
    if (e.target === overlay || e.target === overlay.querySelector('.tb-stage')) close();
  });

  document.querySelectorAll('.trabajo-card').forEach(function (card) {
    card.addEventListener('click', function () {
      var galeria;
      try { galeria = JSON.parse(card.getAttribute('data-galeria') || '[]'); }
      catch (err) { galeria = []; }
      if (!galeria.length) return;
      lastFocused = card;
      open(galeria, card.getAttribute('data-tipo'));
    });
  });
})();
</script>
