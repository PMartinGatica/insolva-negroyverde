---
const segmentos = [
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>`,
    title: "HOGARES",
    body: "Familias que quieren vivir tranquilas: cámaras, alarmas, redes sin zonas muertas y automatización del hogar para controlar todo desde el celular. Protegé tu casa estés donde estés.",
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M5 21V7l8-4v18"/><path d="M19 21V11l-6-4"/></svg>`,
    title: "COMERCIOS Y GASTRONOMÍA",
    body: "Locales, restaurantes y negocios que necesitan videovigilancia con acceso remoto, redes profesionales y sistemas integrados para operar tranquilos y proteger su inversión.",
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>`,
    title: "INDUSTRIAS Y OBRADORES",
    body: "Empresas, industrias y obras en construcción. Monitoreo de obradores con equipos robustos 4G, seguridad perimetral e ingeniería a medida para cada instalación.",
  },
];
---

<section class="py-24 md:py-32 bg-[#F7F7F5]">
  <div class="max-w-7xl mx-auto px-6">

    <div class="reveal mb-16 max-w-2xl">
      <p class="eyebrow mb-4">03 — PARA QUIÉN</p>
      <h2 class="heading-section text-[#0A0A0A]">
        Trabajamos con quien<br />quiere crecer sin caos.
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {segmentos.map((seg, i) => (
        <div class={`reveal reveal-delay-${i + 1} flex flex-col gap-4`}>
          <!-- Ícono -->
          <div class="w-12 h-12 flex items-center justify-center text-[#98C665]" set:html={seg.icon} />

          <!-- Línea separadora -->
          <div class="h-px bg-[#0A0A0A]/10 w-full"></div>

          <!-- Título -->
          <h3 class="font-['Barlow_Condensed'] font-800 uppercase tracking-wider text-base text-[#0A0A0A]">
            {seg.title}
          </h3>

          <!-- Body -->
          <p class="body-text">
            {seg.body}
          </p>
        </div>
      ))}
    </div>

  </div>
</section>
