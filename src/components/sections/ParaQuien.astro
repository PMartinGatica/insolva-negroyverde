---
const segmentos = [
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>`,
    title: "PROFESIONALES INDEPENDIENTES",
    body: "Médicos, abogados, contadores, arquitectos. Profesionales que necesitan presencia digital, sistemas internos y seguridad para su consultorio o estudio.",
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>`,
    title: "NEGOCIOS EN EXPANSIÓN",
    body: "PyMEs en crecimiento: gastronomía, turismo, salud, retail. Negocios que sienten que el desorden crece más rápido que la facturación.",
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>`,
    title: "EMPRESAS CONSOLIDADAS",
    body: "Industrias y empresas medianas que necesitan optimizar procesos, automatizar tareas críticas y reducir el margen de error humano.",
  },
];
---

<section class="py-24 md:py-32 bg-[#F7F7F5]">
  <div class="max-w-7xl mx-auto px-6">

    <div class="reveal mb-16 max-w-2xl">
      <p class="eyebrow mb-4">03 — PARA QUIÉN</p>
      <h2 class="heading-section text-[#0A0A0A]">
        Trabajamos con quien<br />quiere crecer sin caos.
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {segmentos.map((seg, i) => (
        <div class={`reveal reveal-delay-${i + 1} flex flex-col gap-4`}>
          <!-- Ícono -->
          <div class="w-12 h-12 flex items-center justify-center text-[#98C665]" set:html={seg.icon} />

          <!-- Línea separadora -->
          <div class="h-px bg-[#0A0A0A]/10 w-full"></div>

          <!-- Título -->
          <h3 class="font-['Barlow_Condensed'] font-800 uppercase tracking-wider text-base text-[#0A0A0A]">
            {seg.title}
          </h3>

          <!-- Body -->
          <p class="text-sm text-[#4A4A4A] font-['Barlow'] leading-relaxed">
            {seg.body}
          </p>
        </div>
      ))}
    </div>

  </div>
</section>
