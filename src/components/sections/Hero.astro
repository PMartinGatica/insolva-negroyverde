---
import { whatsappLink } from '../../lib/whatsapp';
import { SERVICIOS } from '../../lib/servicios';
const waHref = whatsappLink({ source: 'hero' });
---

<section
  id="hero"
  class="on-dark relative min-h-[95vh] flex items-center overflow-hidden bg-[#090B07]"
>
  <!-- ── Isotipo rotando 360° — igual que esland con video ── -->
  <div class="hero-logo-wrap" aria-hidden="true">
    <!-- blur detrás -->
    <div class="hero-logo-blur">
      <img src="/isotipo-verde.svg" alt="" width="888" height="1075" />
    </div>
    <!-- imagen rotando -->
    <div class="hero-logo-spin">
      <img src="/isotipo-verde.svg" alt="" width="888" height="1075" />
    </div>
  </div>

  <!-- Grid blueprint -->
  <div class="hero-grid" aria-hidden="true"></div>

  <!-- Vignette lateral izquierda para que el texto sea legible -->
  <div class="hero-vignette" aria-hidden="true"></div>

  <!-- Línea inferior -->
  <div class="hero-line" aria-hidden="true"></div>

  <!-- ── Contenido ── --><!-- H1: "Soluciones inteligentes…" (ángulo INSOLVA = soluciones inteligentes) -->
  <div class="relative z-10 wrap py-28 w-full">
    <!-- Antes era max-w-2xl (672px): el titular a ~108px no entraba y se
         partía en seis líneas, empujando los CTA fuera de la primera pantalla. -->
    <div class="max-w-4xl">

      <p class="hero-eyebrow animate-fade-up">
        USHUAIA · RÍO GRANDE · TOLHUIN
      </p>

      <!-- El H1 dice el rubro y la ciudad. El ángulo de marca "soluciones
           inteligentes" (ADR-014) pasa al subtítulo: en el H1 no aportaba
           ninguna de las palabras por las que la gente busca. -->
      <h1 class="hero-h1 animate-fade-up anim-d1">
        Seguridad<br />electrónica
        <span>para tu casa<br />y tu negocio<br />en Ushuaia.</span>
      </h1>

      <p class="hero-sub animate-fade-up anim-d2">
        Cámaras, alarmas, cerraduras digitales, redes, domótica e instalaciones
        eléctricas. Soluciones inteligentes, a medida de tu lugar y sin gastar
        de más.
      </p>

      <div class="hero-ctas animate-fade-up anim-d3">
        <a
          href={waHref}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary"
          aria-label="Pedir presupuesto por WhatsApp a INSOLVA"
        >
          <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Pedí tu presupuesto
        </a>

        <a href="/servicios/" class="btn btn-ghost">
          Ver servicios
        </a>
      </div>

      <!-- Accesos directos a cada página de servicio: sirven al visitante que
           ya sabe qué busca, y son los enlaces internos que hacen que Google
           descubra esas páginas desde la portada. -->
      <ul class="hero-servicios animate-fade-up anim-d3">
        {SERVICIOS.map((serv) => (
          <li>
            <a href={`/${serv.slug}/`}>{serv.nav}</a>
          </li>
        ))}
      </ul>


    </div>
  </div>

</section>

<style>
/* ── Rotación 360° del isotipo ── */
@keyframes spin360 {
  from { transform: rotate(0deg); }
  to   { transform: rotate(360deg); }
}
@keyframes fadeInHero {
  from { opacity: 0; transform: translateY(28px); }
  to   { opacity: 1; transform: translateY(0); }
}

.hero-logo-wrap {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  pointer-events: none;
  overflow: hidden;
}

.hero-logo-blur {
  position: absolute;
  right: -8%;
  width: 62vw;
  max-width: 680px;
  aspect-ratio: 888 / 1075;
  filter: blur(60px);
  opacity: 0.12;
}
.hero-logo-blur img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.hero-logo-spin {
  position: absolute;
  right: -4%;
  width: 52vw;
  max-width: 560px;
  aspect-ratio: 888 / 1075;
  animation: spin360 18s linear infinite;
  transform-origin: center center;
  opacity: 0.55;
}
.hero-logo-spin img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

/* Vignette: oculta el logo detrás del texto */
.hero-vignette {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to right,
    #090B07 30%,
    rgba(9, 11, 7, 0.7) 55%,
    transparent 100%
  );
  pointer-events: none;
}

.hero-grid {
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: 0.05;
  background-image:
    linear-gradient(rgba(152,198,101,1) 1px, transparent 1px),
    linear-gradient(90deg, rgba(152,198,101,1) 1px, transparent 1px);
  background-size: 80px 80px;
}

.hero-line {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, #98C665 50%, transparent);
}

/* ── Tipografía del hero ── */
.hero-eyebrow {
  font-family: 'Space Grotesk', sans-serif;
  font-weight: 500;
  font-size: 0.7rem;
  letter-spacing: 0.28em;
  text-transform: uppercase;
  color: #98C665;
  margin-bottom: 1.5rem;
}

.hero-h1 {
  font-family: 'BlauerNue', 'Space Grotesk', sans-serif;
  font-weight: 900;
  text-transform: uppercase;
  line-height: 0.88;
  letter-spacing: -0.025em;
  font-size: clamp(2.6rem, 6.4vw, 5.6rem);
  color: #ffffff;
  margin-bottom: 1.75rem;
}
.hero-h1 span { color: #98C665; }

.hero-sub {
  font-family: 'Space Grotesk', sans-serif;
  font-weight: 300;
  font-size: clamp(1rem, 1.25vw, 1.15rem);
  line-height: 1.6;
  color: #AFB2AD;
  margin-bottom: 2.25rem;
  max-width: 34rem;
}

.hero-ctas {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  margin-bottom: 2rem;
}

/* Los botones usan .btn / .btn-primary / .btn-ghost de global.css. Antes esta
   sección tenía su propia copia de los estilos, que chocaba con la global. */

/* Accesos directos a las páginas de servicio */
.hero-servicios {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1.5rem;
  margin-bottom: 3rem;
  padding-top: 1.75rem;
  border-top: 1px solid rgba(255, 255, 255, 0.12);
  max-width: 34rem;
}
.hero-servicios a {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 0.82rem;
  color: #AFB2AD;
  text-decoration: none;
  transition: color 0.2s;
}
.hero-servicios a:hover { color: #98C665; }


/* ── Animaciones de entrada ── */
.animate-fade-up {
  opacity: 0;
  animation: fadeInHero 0.8s cubic-bezier(0.22,1,0.36,1) forwards;
}
.anim-d1 { animation-delay: 0.1s; }
.anim-d2 { animation-delay: 0.22s; }
.anim-d3 { animation-delay: 0.36s; }
.anim-d4 { animation-delay: 0.5s; }

@media (max-width: 768px) {
  .hero-logo-spin {
    right: -20%;
    width: 90vw;
    opacity: 0.25;
  }
  .hero-logo-blur { opacity: 0.06; }
}
</style>
