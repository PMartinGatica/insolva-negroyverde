---
/**
 * Franja "Confían en INSOLVA": fondo claro y logos en gris suave. Va entre el
 * hero y la sección del video de la casa, y cierra con el "Scroll", que es la
 * invitación a bajar al video (la sección que sigue), no al hero.
 *
 * Los logos son PNG de una sola tinta en `public/img/clientes/`, generados
 * desde `src/LOGOS/` con `scripts/build-logos-clientes.mjs`.
 *
 * PARA SUMAR UNO: dejar el original en `src/LOGOS/`, agregarlo al script,
 * correrlo y sumar una línea a `CLIENTES`. Con 6 o más pasa solo a una cinta
 * continua que se desplaza.
 *
 * REGLA: solo clientes reales y con su permiso.
 */
const CLIENTES = [
  { nombre: 'Prismatica', archivo: 'prismatica', ancho: 520, alto: 343 },
  { nombre: 'Chez Manu',  archivo: 'chez-manu',  ancho: 520, alto: 205 },
  { nombre: 'Kau Kren',  archivo: 'k',          ancho: 420, alto: 420 },
  { nombre: 'Biorn',      archivo: 'biorn',      ancho: 420, alto: 287 },
];

// Con pocos clientes se repite la serie hasta llenar el ancho; la cinta corre
// siempre, como el carrusel de logos de referencia.
const SERIE = Array.from({ length: 4 }, () => CLIENTES).flat();
---

<section class="clientes" aria-labelledby="clientes-titulo">
  <div class="wrap clientes-inner">

    <p id="clientes-titulo" class="clientes-rotulo">Confían en INSOLVA</p>

    <div class="clientes-ventana">
      <ul class="clientes-cinta">
        {[...SERIE, ...SERIE].map((c, i) => (
          <li aria-hidden={i >= SERIE.length ? 'true' : undefined}>
            <img
              src={`/img/clientes/${c.archivo}.png`}
              alt={i >= SERIE.length ? '' : c.nombre}
              width={c.ancho}
              height={c.alto}
              loading="lazy"
              decoding="async"
            />
          </li>
        ))}
      </ul>
    </div>

    <!-- Invitación a bajar: apunta a la sección del video de la casa. -->
    <div class="clientes-scroll" aria-hidden="true">
      <span class="clientes-scroll-linea"></span>
      <span class="clientes-scroll-texto">Scroll</span>
    </div>

  </div>
</section>

<style>
  .clientes {
    background: var(--paper);
    border-bottom: 1px solid var(--line-on-light);
    padding-block: clamp(1.75rem, 3.2vw, 2.75rem) clamp(1.25rem, 2.2vw, 1.75rem);
  }

  .clientes-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(1.25rem, 2.4vw, 1.9rem);
  }

  .clientes-rotulo {
    margin: 0;
    font-family: 'enma', 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: 0.72rem;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--text-on-light-2);
  }

  /* ── Pocos logos: fijos, parejos, centrados ───────────────────────── */
  .clientes-fijos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.25rem clamp(2.5rem, 7vw, 5.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Misma altura visual para los tres aunque el dibujo sea más ancho o más alto. */
  .clientes-cinta img {
    display: block;
    height: clamp(34px, 4.2vw, 50px);
    width: auto;
    max-width: 180px;
    object-fit: contain;
    /* Negro sobre transparente → gris suave; recupera contraste al pasar. */
    opacity: 0.68;
    transition: opacity 0.3s var(--ease-out-quart);
  }
  .clientes-cinta li:hover img { opacity: 0.95; }

  /* ── Carrusel (6 o más): cinta continua con bordes que se funden ──── */
  .clientes-ventana {
    width: 100%;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
            mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .clientes-cinta {
    display: flex;
    align-items: center;
    width: max-content;
    margin: 0;
    padding: 0;
    list-style: none;
    animation: clientes-correr 40s linear infinite;
  }
  .clientes-ventana:hover .clientes-cinta { animation-play-state: paused; }
  /* Casillero fijo por logo, como los slides del carrusel de referencia. */
  .clientes-cinta li {
    flex: none;
    width: clamp(132px, 15vw, 190px);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @keyframes clientes-correr {
    from { transform: translateX(0); }
    /* Lista duplicada: a la mitad vuelve al inicio sin salto. */
    to   { transform: translateX(-50%); }
  }

  /* ── Scroll: línea + texto, centrado bajo los logos ───────────────── */
  .clientes-scroll {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }
  .clientes-scroll-linea {
    width: 1px;
    height: 2rem;
    background: var(--green-text);
  }
  .clientes-scroll-texto {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.62rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--text-on-light-2);
  }

  @media (prefers-reduced-motion: reduce) {
    .clientes-cinta { animation: none; flex-wrap: wrap; justify-content: center; width: 100%; }
    .clientes-cinta li[aria-hidden='true'] { display: none; }
    .clientes-ventana { -webkit-mask-image: none; mask-image: none; }
  }
</style>
