---
import { SERVICIOS_SEGURIDAD } from '../../lib/constants';
---

<section id="pilares" class="py-24 md:py-32 bg-[#FFFFFF]">
  <div class="max-w-7xl mx-auto px-6">

    <!-- Header sección -->
    <div class="reveal mb-16 max-w-2xl">
      <p class="eyebrow mb-4">SERVICIOS</p>
      <h2 class="heading-section text-[#0A0A0A]">
        Seguridad completa<br />para tu casa o negocio.
      </h2>
      <p class="body-text mt-5">
        Cámaras, alarmas, redes y automatización. Todo instalado a medida de tu
        lugar, sin puntos ciegos y con acceso desde el celular.
      </p>
    </div>

    <!-- Grid de categorías de seguridad -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {SERVICIOS_SEGURIDAD.map((serv, index) => (
        <article
          class={`
            reveal reveal-delay-${(index % 2) + 1}
            group relative flex flex-col
            border border-[#0A0A0A]/10 rounded-sm
            bg-[#F7F7F5] overflow-hidden
            hover:border-[#98C665]/60 transition-all duration-300
          `}
        >
          {serv.image && (
            <div class="relative w-full aspect-[4/3] overflow-hidden bg-[#0F0F0F]">
              <img
                src={serv.image}
                alt={`${serv.title} — INSOLVA Group`}
                loading="lazy"
                decoding="async"
                class="w-full h-full object-contain transition-transform duration-500 group-hover:scale-105"
              />
            </div>
          )}

          <div class="p-8 flex flex-col flex-1">
            <!-- Título + número -->
            <div class="flex items-start justify-between mb-4">
              <h4 class="heading-card text-[#0A0A0A]">{serv.title}</h4>
              <span
                class="font-['Barlow_Condensed'] font-900 text-4xl leading-none text-[#C2C1C1]/40 select-none"
                aria-hidden="true"
              >
                {serv.number}
              </span>
            </div>

            <!-- Resumen -->
            <p class="body-text mb-6">{serv.resumen}</p>

            <!-- Separador verde -->
            <div class="h-px bg-[#98C665] w-12 mb-6"></div>

            <!-- Items -->
            <ul class="space-y-2 flex-1">
              {serv.items.map((item) => (
                <li class="flex items-start gap-2 body-text">
                  <span class="text-[#98C665] mt-0.5 flex-shrink-0" aria-hidden="true">▸</span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>
