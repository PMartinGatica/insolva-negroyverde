---
import { SERVICIOS } from '../../lib/servicios';

/*
  "Qué hacemos" de la home: solo el índice.

  Sin fotos a propósito. Antes esta sección mostraba la misma foto de portada
  que después repite /servicios, y el sitio se leía dos veces igual. Acá va el
  nombre, una línea y el link; el detalle con fotos y videos vive en Servicios.
*/
---

<section id="pilares" class="section section-light">
  <div class="wrap">

    <div class="reveal mb-14 max-w-3xl">
      <p class="eyebrow mb-4">QUÉ HACEMOS</p>
      <h2 class="heading-section text-[#11140F]">
        Soluciones que<br />trabajan juntas.
      </h2>
      <p class="body-text mt-6 max-w-xl">
        Cámaras, alarmas, cerraduras digitales, domótica, redes y electricidad.
        Las hacemos todas nosotros, así el sistema queda integrado en lugar de
        ser cinco instalaciones sueltas de cinco personas distintas.
      </p>
    </div>

    <ul class="grid md:grid-cols-2 gap-x-14">
      {SERVICIOS.map((serv, i) => (
        <li class={`reveal reveal-delay-${(i % 3) + 1}`}>
          <a
            href={`/${serv.slug}/`}
            class="group flex gap-6 py-7 border-t border-[#11140F]/12 hover:border-[#98C665] transition-colors"
          >
            <span class="num-index !text-[2rem] shrink-0 w-12" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span class="flex-1">
              <span class="heading-card text-[#11140F] block mb-2 group-hover:text-[#4F7D22] transition-colors">
                {serv.nav}
              </span>
              <span class="body-text block">{serv.resumen}</span>
            </span>
            <span
              class="text-[#4F7D22] shrink-0 self-center transition-transform duration-300 group-hover:translate-x-1"
              aria-hidden="true"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" />
              </svg>
            </span>
          </a>
        </li>
      ))}
    </ul>

    <div class="reveal mt-12">
      <a href="/servicios/" class="btn btn-ghost">Ver todos los servicios</a>
    </div>

  </div>
</section>
