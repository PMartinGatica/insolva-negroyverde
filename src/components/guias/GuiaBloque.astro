---
import type { Bloque } from '../../lib/guias';

/**
 * Un bloque de contenido de una guía, con el look de los reels de INSOLVA:
 * fondo negro, títulos grandes, verde de acento, cosas que entran de a una.
 *
 * Todo el texto está en el HTML desde el build (Google y los buscadores con IA
 * lo leen entero). La interactividad (checklists que se tildan y se guardan,
 * pestañas de la comparativa) la agrega el script de la página de la guía y,
 * sin JavaScript, el bloque se ve completo igual.
 */
interface Props {
  bloque: Bloque;
  /** Número de lección vigente (solo cuenta para los bloques "leccion"). */
  numero: number;
  /** Clave única del bloque (slug + índice): guarda el progreso del checklist. */
  clave: string;
}

const { bloque: b, numero, clave } = Astro.props;
const dos = (n: number) => String(n).padStart(2, '0');
const delay = (i: number) => `reveal-delay-${(i % 4) + 1}`;

// Comparativa: si la primera columna es "", es el nombre de cada fila.
const conFilas = b.tipo === 'comparativa' && b.columnas[0] === '';
const opciones = b.tipo === 'comparativa' ? b.columnas.map((c, i) => ({ c, i })).filter(({ i }) => !conFilas || i > 0) : [];
---

{b.tipo === 'p' && <p class="g-p">{b.texto}</p>}

{b.tipo === 'h' && <h3 class="heading-card text-white mt-4">{b.texto}</h3>}

{b.tipo === 'leccion' && (
  <div id={`leccion-${numero}`} class="scroll-mt-28">
    <p class="eyebrow">Lección {dos(numero)}</p>
    <h2 class="heading-sub text-white mt-2">{b.titulo}</h2>
  </div>
)}

{b.tipo === 'lista' && (
  <ul class="grid gap-3">
    {b.items.map((it, i) => (
      <li class={`reveal ${delay(i)} g-card grid grid-cols-[2.25rem_1fr] gap-3 items-start`}>
        <span aria-hidden="true" class="g-num">{dos(i + 1)}</span>
        <span class="g-li">{it}</span>
      </li>
    ))}
  </ul>
)}

{b.tipo === 'check' && (
  <div class="g-check" data-check={clave}>
    <div class="flex flex-wrap items-end justify-between gap-3 mb-4">
      <h3 class="heading-card text-white !text-[1.15rem]">{b.titulo ?? 'Antes de decidir, tildá lo que ya tenés'}</h3>
      <p class="eyebrow" aria-live="polite"><span data-check-cuenta>0</span> de {b.items.length} listos</p>
    </div>
    <div class="g-barra" aria-hidden="true"><span data-check-barra></span></div>
    <ul class="mt-5 flex flex-col gap-2">
      {b.items.map((it, i) => (
        <li class={`reveal ${delay(i)}`}>
          <label class="g-check-item">
            <input type="checkbox" class="g-check-input" data-check-item={i} />
            <span class="g-check-caja" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
            </span>
            <span class="g-li">{it}</span>
          </label>
        </li>
      ))}
    </ul>
    <p class="g-listo mt-5" data-check-listo hidden>Todo tildado. Si querés que lo revisemos con vos, escribinos.</p>
  </div>
)}

{b.tipo === 'pasos' && (
  <ol class="g-pasos">
    {b.items.map((it, i) => (
      <li class="reveal g-paso">
        <span class="g-paso-nodo" aria-hidden="true"></span>
        <p class="eyebrow">{i + 1} · Paso</p>
        <h3 class="heading-card text-white mt-2 !text-[clamp(1.35rem,2.6vw,1.9rem)]">{it.titulo}</h3>
        <p class="g-li mt-3">{it.texto}</p>
      </li>
    ))}
  </ol>
)}

{b.tipo === 'nota' && (
  <aside class="reveal g-nota">
    <p class="eyebrow mb-2">Ojo con esto</p>
    <p class="heading-card text-white !text-[1.1rem]">{b.titulo}</p>
    <p class="g-li mt-2">{b.texto}</p>
  </aside>
)}

{b.tipo === 'specs' && (
  <div class="reveal g-specs">
    {b.titulo && <h2 class="eyebrow px-5 py-3 border-b border-white/10">{b.titulo}</h2>}
    <dl>
      {b.filas.map(([k, v]) => (
        <div class="grid gap-1 px-5 py-3.5 border-b border-white/10 last:border-0 sm:grid-cols-[12rem_1fr] sm:gap-4">
          <dt class="text-sm text-[#AFB2AD]">{k}</dt>
          <dd class="font-medium text-white">{v}</dd>
        </div>
      ))}
    </dl>
  </div>
)}

{b.tipo === 'comparativa' && (
  <div class="reveal g-comp" data-tabs>
    <!-- Pestañas: una opción a la vez, como en el reel. -->
    <div class="g-tabs" role="tablist" aria-label="Opciones para comparar">
      {opciones.map(({ c, i }, n) => (
        <button type="button" role="tab" class="g-tab" data-tab={n} aria-selected={n === 0 ? 'true' : 'false'}>
          {c}
        </button>
      ))}
    </div>
    {opciones.map(({ c, i }, n) => (
      <div class="g-panel" role="tabpanel" data-panel={n} aria-label={c}>
        <p class="heading-sub text-[#98C665]">{c}</p>
        <dl class="mt-4">
          {b.filas.map((fila) => (
            <div class="grid gap-1 py-3 border-b border-white/10 last:border-0 sm:grid-cols-[11rem_1fr] sm:gap-4">
              {conFilas && <dt class="text-sm text-[#AFB2AD]">{fila[0]}</dt>}
              <dd class="text-white">{fila[i]}</dd>
            </div>
          ))}
        </dl>
      </div>
    ))}
  </div>
)}

<style>
  .g-p {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.08rem;
    line-height: 1.75;
    color: var(--text-on-dark-2);
  }
  .g-li {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.02rem;
    line-height: 1.65;
    color: var(--text-on-dark-2);
  }
  .g-card {
    border: 1px solid rgb(255 255 255 / 0.1);
    background: rgb(255 255 255 / 0.03);
    padding: 1rem 1.1rem;
    border-radius: 0.5rem;
  }
  .g-num {
    font-family: 'BlauerNue', 'Space Grotesk', sans-serif;
    font-weight: 900;
    font-size: 1.15rem;
    color: var(--green);
    line-height: 1.5;
  }

  /* Pasos: línea punteada verde que los une, como el reel del WiFi. */
  .g-pasos {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
    padding-left: 2rem;
  }
  .g-pasos::before {
    content: '';
    position: absolute;
    left: 0.4rem;
    top: 0.4rem;
    bottom: 0.4rem;
    width: 2px;
    background: repeating-linear-gradient(to bottom, var(--green) 0 4px, transparent 4px 10px);
    opacity: 0.6;
  }
  .g-paso { position: relative; }
  .g-paso-nodo {
    position: absolute;
    left: calc(-2rem + 0.4rem - 6px);
    top: 0.1rem;
    width: 14px;
    height: 14px;
    border-radius: 999px;
    background: #11140F;
    border: 2px solid var(--green);
  }
  :global(.js) .g-paso.visible .g-paso-nodo { background: var(--green); transition: background 0.5s 0.3s; }

  .g-nota {
    border-left: 3px solid var(--green);
    background: rgb(152 198 101 / 0.08);
    padding: 1.1rem 1.25rem;
    border-radius: 0 0.5rem 0.5rem 0;
  }

  .g-specs {
    border: 1px solid rgb(255 255 255 / 0.1);
    border-radius: 0.5rem;
    background: rgb(255 255 255 / 0.03);
  }

  /* Checklist interactivo */
  .g-check {
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 0.75rem;
    padding: 1.25rem;
    background: rgb(255 255 255 / 0.03);
  }
  @media (min-width: 640px) { .g-check { padding: 1.75rem; } }
  .g-barra {
    height: 4px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.1);
    overflow: hidden;
  }
  .g-barra span {
    display: block;
    height: 100%;
    width: 100%;
    background: var(--green);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s var(--ease-out-quart);
  }
  .g-check-item {
    display: grid;
    grid-template-columns: 1.6rem 1fr;
    gap: 0.85rem;
    align-items: start;
    padding: 0.75rem 0.5rem;
    border-radius: 0.5rem;
    cursor: pointer;
    transition: background 0.2s;
  }
  .g-check-item:hover { background: rgb(255 255 255 / 0.04); }
  .g-check-input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .g-check-caja {
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 0.35rem;
    border: 2px solid rgb(255 255 255 / 0.35);
    display: grid;
    place-items: center;
    color: #11140F;
    transition: background 0.2s, border-color 0.2s;
  }
  .g-check-caja svg { width: 1rem; height: 1rem; opacity: 0; transform: scale(0.6); transition: opacity 0.2s, transform 0.25s var(--ease-out-quart); }
  .g-check-input:checked + .g-check-caja { background: var(--green); border-color: var(--green); }
  .g-check-input:checked + .g-check-caja svg { opacity: 1; transform: none; }
  .g-check-input:checked ~ .g-li { color: #fff; }
  .g-check-input:focus-visible + .g-check-caja { outline: 2px solid var(--green); outline-offset: 2px; }
  .g-listo {
    font-family: 'Space Grotesk', sans-serif;
    color: var(--green);
    font-weight: 500;
  }

  /* Comparativa con pestañas. Sin JS se ven todos los paneles uno abajo del otro. */
  .g-comp {
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 0.75rem;
    padding: 1.25rem;
    background: rgb(255 255 255 / 0.03);
  }
  .g-tabs { display: none; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; }
  :global(.js) .g-tabs { display: flex; }
  .g-tab {
    font-family: 'enma', 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-on-dark-2);
    border: 1px solid rgb(255 255 255 / 0.2);
    border-radius: 999px;
    padding: 0.6rem 1rem;
    min-height: 2.75rem;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }
  .g-tab:hover { border-color: var(--green); color: #fff; }
  .g-tab[aria-selected='true'] { background: var(--green); border-color: var(--green); color: #11140F; }
  .g-panel + .g-panel { margin-top: 1.75rem; }
  :global(.js) .g-panel + .g-panel { margin-top: 0; }
  :global(.js) .g-panel[hidden] { display: none; }
  :global(.js) .g-panel:not([hidden]) { animation: g-entra 0.45s var(--ease-out-quart); }
  @keyframes g-entra { from { opacity: 0; transform: translateX(14px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .g-panel:not([hidden]) { animation: none; }
  }
</style>
