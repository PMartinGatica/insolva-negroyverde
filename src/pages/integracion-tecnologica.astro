<script>
  // Método: la línea se llena al bajar y se prende el paso en el que estás.
  const metodo = document.querySelector<HTMLElement>('[data-metodo]');
  const pasos = Array.from(document.querySelectorAll<HTMLElement>('[data-paso]'));
  let pendiente = false;
  function medir() {
    pendiente = false;
    if (!metodo) return;
    const vh = window.innerHeight;
    const r = metodo.getBoundingClientRect();
    metodo.style.setProperty('--avance', String(Math.min(1, Math.max(0, (vh * 0.6 - r.top) / r.height))));
    pasos.forEach((p) => p.classList.toggle('activa', p.getBoundingClientRect().top < vh * 0.6));
  }
  const pedir = () => { if (!pendiente) { pendiente = true; requestAnimationFrame(medir); } };
  window.addEventListener('scroll', pedir, { passive: true });
  window.addEventListener('resize', pedir);
  medir();

  // Pestañas (herramientas y zonas de analítica).
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((grupo) => {
    const tabs = Array.from(grupo.querySelectorAll<HTMLButtonElement>('[data-tab]'));
    const paneles = Array.from(grupo.querySelectorAll<HTMLElement>('[data-panel]'));
    const elegir = (n: number) => {
      tabs.forEach((t, i) => t.setAttribute('aria-selected', String(i === n)));
      paneles.forEach((p, i) => (p.hidden = i !== n));
    };
    tabs.forEach((t, i) => t.addEventListener('click', () => elegir(i)));
    elegir(0);
  });
</script>
