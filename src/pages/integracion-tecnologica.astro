---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import WhatsAppFloat from '../components/ui/WhatsAppFloat.astro';
import CookieBanner from '../components/ui/CookieBanner.astro';
import { whatsappLink } from '../lib/whatsapp';
import { breadcrumbSchema, faqSchema, serviceSchema } from '../lib/seo';
import { existsSync } from 'node:fs';

// Una foto solo se muestra si el archivo está en public/ (las de herramientas
// Lean se suman a mano: ver CREDITOS_LEAN más abajo).
const hayFoto = (src: string) => existsSync(new URL(`../../public${src}`, import.meta.url));

/*
  INGENIERÍA DE PROCESOS + INTEGRACIÓN TECNOLÓGICA (para empresas).

  EN ARMADO (noviembre 2026): la página está oculta. `noindex`, fuera del
  sitemap (astro.config.mjs) y sin enlaces desde el menú, el footer ni
  llms.txt. Se ve solo entrando a /integracion-tecnologica/. Para mostrarla:
  sacar `noindex`, sacar el filtro del sitemap y sumar los enlaces.

  REGLAS DE CONTENIDO
  - Nada de casos, clientes ni cifras que no existan. La analítica de
    Hikvision se presenta como algo que INSOLVA puede implementar, con modelos
    "por ejemplo" que se confirman en cada presupuesto.
  - Casi sin fotos (todavía no hay de estos trabajos): diagramas y tarjetas.
  - Voz propia. La idea "primero el proceso, después la tecnología" es
    compartida con el mundo Lean, pero las frases son nuestras.
*/

const path = '/integracion-tecnologica';
const titulo = 'Ingeniería de procesos e integración tecnológica en Tierra del Fuego | INSOLVA Group';
const descripcion =
  'Ordenamos la operación con Lean, 5S y Kaizen, la medimos con analítica de video y la automatizamos. Ingeniería de procesos y tecnología para empresas de Ushuaia, Río Grande y Tolhuin.';

const wa = whatsappLink({
  message: 'Hola INSOLVA, tengo una empresa y quiero ordenar y medir un proceso.',
});

const sintomas = [
  {
    titulo: 'Un sistema nuevo sobre el mismo desorden',
    texto: 'Se compra un software de stock y el depósito sigue igual. Ahora el desorden está también en la pantalla.',
  },
  {
    titulo: 'Todo depende de una persona',
    texto: 'Si falta el encargado, nadie sabe dónde está cada cosa ni cómo se hace. El proceso vive en la cabeza de alguien.',
  },
  {
    titulo: 'Se decide a ojo',
    texto: '¿Cuánta gente entra? ¿A qué hora conviene reforzar la caja? ¿Qué góndola no mira nadie? Sin datos, se adivina.',
  },
];

const metodo = [
  {
    clave: 'Ir al lugar',
    titulo: 'Relevamos donde pasa el trabajo',
    texto: 'Vamos al salón, al depósito o a la planta, miramos cómo se trabaja hoy y escuchamos a la gente que lo hace todos los días. Ahí aparecen los problemas reales.',
  },
  {
    clave: 'Ordenar',
    titulo: 'Sacamos lo que no suma',
    texto: 'Con 5S y estandarización dejamos cada cosa en su lugar y cada tarea con una forma clara de hacerse. Es barato y es la base de todo lo que viene.',
  },
  {
    clave: 'Medir',
    titulo: 'Ponemos números donde había intuición',
    texto: 'Indicadores simples, tableros visuales y, cuando conviene, cámaras con analítica que cuentan personas, miden filas y muestran por dónde circula la gente.',
  },
  {
    clave: 'Integrar',
    titulo: 'Recién ahí, la tecnología',
    texto: 'Automatizamos lo repetitivo, conectamos los sistemas entre sí y dejamos los datos a mano en el celular. Tecnología sobre un proceso que ya funciona.',
  },
  {
    clave: 'Mejorar',
    titulo: 'Y lo sostenemos en el tiempo',
    texto: 'Revisamos los resultados con el equipo y ajustamos. La mejora continua (Kaizen) es un hábito, no un proyecto que se termina.',
  },
];

/*
  Fotos de herramientas: Wikimedia Commons, licencia CC BY-SA (exige citar
  autor y licencia; va en el pie de cada foto). Se bajan de los links de
  `fuente`, se pasan a .webp y se guardan en public/img/empresas/lean/ con el
  nombre de `foto`. Mientras no estén, la pestaña se ve sin foto.
*/
const LEAN = '/img/empresas/lean';
const SCANFIL = { autor: 'Adrian Grycuk', licencia: 'CC BY-SA 3.0 PL', licenciaUrl: 'https://creativecommons.org/licenses/by-sa/3.0/pl/deed.es' };

const herramientas = [
  {
    nombre: '5S', que: 'Cinco pasos para ordenar un lugar de trabajo: clasificar, ordenar, limpiar, estandarizar y sostener.', sirve: 'Encontrar todo en segundos y que el orden dure.',
    foto: `${LEAN}/5s.webp`, alt: 'Tableros de 5S en una planta de producción', ...SCANFIL,
    fuente: 'https://commons.wikimedia.org/wiki/File:Kaizen_5S_boards_Scanfil_Sieradz.jpg',
  },
  {
    nombre: 'Kaizen', que: 'Mejora continua: cambios chicos y frecuentes, propuestos por la misma gente que hace el trabajo.', sirve: 'Mejorar todas las semanas sin grandes inversiones.',
    foto: `${LEAN}/kaizen.webp`, alt: 'Tableros del programa de sugerencias de mejora del personal', ...SCANFIL,
    fuente: 'https://commons.wikimedia.org/wiki/File:Kaizen_employee_sugestion_program_boards_Scanfil_Sieradz.jpg',
  },
  {
    nombre: 'Gemba', que: 'Ir al lugar donde se hace el trabajo para entender el problema antes de proponer una solución.', sirve: 'Decidir con lo que pasa de verdad, no con lo que se supone.',
    foto: `${LEAN}/gemba.webp`, alt: 'Depósito de una planta, el lugar donde pasa el trabajo', ...SCANFIL,
    fuente: 'https://commons.wikimedia.org/wiki/File:Warehouse_Scanfil_Sieradz.jpg',
  },
  {
    nombre: 'Estandarización', que: 'Escribir la mejor forma conocida de hacer cada tarea, para que todos la hagan igual.', sirve: 'Menos errores y capacitar más rápido a la gente nueva.',
    foto: `${LEAN}/estandarizacion.webp`, alt: 'Panel de herramientas con la silueta de cada una marcada', autor: 'Maxschiraldi', licencia: 'CC BY-SA 4.0', licenciaUrl: 'https://creativecommons.org/licenses/by-sa/4.0/deed.es',
    fuente: 'https://commons.wikimedia.org/wiki/File:Shadowboard-mmschiraldi.jpg',
  },
  {
    nombre: 'Gestión visual', que: 'Tableros, colores y señales que muestran de un vistazo cómo viene el trabajo.', sirve: 'Ver los desvíos en el momento, sin pedir un informe.',
    foto: `${LEAN}/gestion-visual.webp`, alt: 'Tableros de indicadores en una planta', ...SCANFIL,
    fuente: 'https://commons.wikimedia.org/wiki/File:KPI_boards_Scanfil_Sieradz.jpg',
  },
  {
    nombre: 'Kanban', que: 'Tarjetas o señales que avisan cuándo reponer o producir, según lo que se consume.', sirve: 'Menos faltantes y menos stock parado.',
    foto: `${LEAN}/kanban.webp`, alt: 'Contenedores chicos ordenados en estanterías de depósito', ...SCANFIL,
    fuente: 'https://commons.wikimedia.org/wiki/File:Warehouse_small_containers_Scanfil_Sieradz.jpg',
  },
  {
    nombre: 'TPM', que: 'Mantenimiento productivo total: cuidar las máquinas entre todos para que no se rompan.', sirve: 'Menos paradas imprevistas y equipos que duran más.',
    foto: `${LEAN}/tpm.webp`, alt: 'Puesto de limpieza y cuidado de equipos en una planta', ...SCANFIL,
    fuente: 'https://commons.wikimedia.org/wiki/File:Cleanliness_point_5S_Scanfil_Sieradz.jpg',
  },
].map((h) => ({ ...h, conFoto: hayFoto(h.foto) }));

const camaras = [
  {
    zona: 'Salón',
    tipo: 'Ojo de pez 360°',
    para: 'Mapas de calor en salones, tiendas y restaurantes',
    texto: 'Una sola cámara en el centro del techo cubre todo el ambiente. Corrige la imagen curva en vistas normales y arma el mapa de calor: qué góndolas o mesas tienen más movimiento y dónde la gente se queda más tiempo.',
    modelos: 'Por ejemplo: Hikvision DS-2CD6365G1-IVS (6 MP) o DS-2CD63C5G0-IVS (12 MP).',
    escena: { src: '/img/empresas/hik-ojo-de-pez.webp', alt: 'Cámara ojo de pez Hikvision en el techo de un supermercado', w: 560, h: 315 },
  },
  {
    zona: 'Puerta',
    tipo: 'Doble lente (3D)',
    para: 'Conteo de entradas y salidas',
    texto: 'Va justo arriba del acceso. Con dos lentes ve en tres dimensiones, mide la altura de lo que pasa por debajo y cuenta personas con mucha precisión, sin confundirse con carritos, cochecitos, sombras o mascotas.',
    modelos: 'Por ejemplo: Hikvision DS-2CD6825G0/C-IVS.',
    escena: { src: '/img/empresas/hik-conteo-puerta.webp', alt: 'Cámara de doble lente contando personas en la entrada de un local', w: 643, h: 366 },
    producto: { src: '/img/empresas/hik-doble-lente.webp', alt: 'Cámara Hikvision de doble lente para conteo de personas', w: 800, h: 531 },
  },
  {
    zona: 'Filas y playa',
    tipo: 'Bullet o domo DeepinView',
    para: 'Filas de caja, estacionamientos y estaciones de servicio',
    texto: 'Distingue autos, camiones, motos y peatones, mide cuánto tiempo queda cada vehículo en cada isla y detecta cuando la fila de cobro se demora. Puede sumar lectura de patentes.',
    modelos: 'Por ejemplo: serie Hikvision iDS-2CD7A46G0, o cámaras con lectura de patentes (LPR).',
    escena: { src: '/img/empresas/hik-filas-caja.webp', alt: 'Analítica de filas en las cajas de un comercio, con el tiempo de espera de cada zona', w: 1200, h: 675 },
    producto: { src: '/img/empresas/hik-bullet.webp', alt: 'Cámara bullet Hikvision DeepinView', w: 800, h: 800 },
  },
];

const metricas = [
  { nombre: 'Flujo de personas', mide: 'Cuántas personas o vehículos entran, salen o pasan por el frente.', uso: 'Cruzado con las ventas, da la conversión: cuántos entran y cuántos compran.', foto: '/img/empresas/hik-ingreso.webp', alt: 'Personas entrando a un local por el acceso' },
  { nombre: 'Mapa de calor', mide: 'Las zonas con más tránsito y más permanencia, de azul a rojo.', uso: 'Encontrar las zonas frías y mover productos, promociones o mesas.', foto: '/img/empresas/hik-mapa-calor.webp', alt: 'Mapa de calor sobre las góndolas de un supermercado' },
  { nombre: 'Filas', mide: 'Cuánta gente espera en una zona y cuánto tiempo.', uso: 'Avisar al encargado para abrir otra caja cuando la espera pasa un límite.', foto: '/img/empresas/hik-filas.webp', alt: 'Vista desde arriba de clientes esperando en un mostrador' },
  { nombre: 'Aforo y recorridos', mide: 'Cuánta gente hay adentro en cada momento y hacia dónde se mueve.', uso: 'Conocer los horarios pico, armar los turnos del personal y respetar la capacidad.', foto: '/img/empresas/hik-recorridos.webp', alt: 'Recorridos de los clientes dentro de un local, con el porcentaje de cada dirección' },
];

const cadena = [
  { nombre: 'Cámaras IP', detalle: 'Analizan la imagen en su propio chip' },
  { nombre: 'Switch PoE', detalle: 'Un cable lleva datos y energía' },
  { nombre: 'NVR o HikCentral', detalle: 'Junta las cámaras y guarda los datos' },
  { nombre: 'Panel y reportes', detalle: 'Gráficos por día, semana o mes, y Excel' },
  { nombre: 'Tu sistema', detalle: 'Opcional: los datos por API a tu software' },
];

const equipo = [
  { area: 'Ingeniería industrial', aporta: 'Procesos, Lean, indicadores' },
  { area: 'Ingeniería electrónica y automatización', aporta: 'PLC, sensores, tableros' },
  { area: 'Ingeniería en producto', aporta: 'Diseño de soluciones a medida' },
  { area: 'Técnica eléctrica', aporta: 'Instalación y puesta en marcha' },
];

const faqs = [
  {
    pregunta: '¿Qué es la ingeniería de procesos?',
    respuesta: 'Es analizar cómo se hace el trabajo en una empresa, de punta a punta, para sacar los pasos que no suman, ordenar el flujo y medir los resultados. El objetivo es hacer lo mismo con menos tiempo, menos errores y menos costo.',
  },
  {
    pregunta: '¿Por qué ordenar el proceso antes de sumar tecnología?',
    respuesta: 'Porque la tecnología copia lo que encuentra. Un sistema montado sobre un proceso desordenado solo hace más rápido el desorden. Primero se ordena con herramientas como 5S y estandarización, y después se automatiza lo que ya funciona.',
  },
  {
    pregunta: '¿Qué son las 5S?',
    respuesta: 'Un método japonés de cinco pasos para ordenar un lugar de trabajo: clasificar (sacar lo que no sirve), ordenar (un lugar para cada cosa), limpiar, estandarizar (que todos lo hagan igual) y sostener (que se vuelva hábito).',
  },
  {
    pregunta: '¿Qué es el conteo de personas con cámaras?',
    respuesta: 'Son cámaras con inteligencia artificial que cuentan cuánta gente entra y sale de un local, miden las filas y arman mapas de calor del salón. Los datos se ven en gráficos diarios, semanales o mensuales y sirven para calcular la conversión y organizar al personal.',
  },
  {
    pregunta: '¿Se puede usar con las cámaras que ya tengo?',
    respuesta: 'Depende. La analítica necesita cámaras IP con esa función; una cámara analógica o un grabador básico no alcanza. Relevamos lo que ya está instalado y aprovechamos todo lo que se pueda: el cableado, la red o el grabador.',
  },
  {
    pregunta: '¿Los datos se pueden pasar a mi propio sistema?',
    respuesta: 'Sí. Se pueden ver en el panel de Hikvision o extraer en tiempo real con su API para integrarlos con tu sistema de ventas, de stock o de turnos. Esa integración la desarrollamos nosotros.',
  },
  {
    pregunta: '¿Funcionan con el frío de Tierra del Fuego?',
    respuesta: 'Para exterior se eligen modelos con protección IP67 contra agua y polvo y rango de temperatura para frío extremo. El modelo exacto se confirma según dónde va cada cámara.',
  },
  {
    pregunta: '¿Dónde trabajan?',
    respuesta: 'En Ushuaia, Río Grande y Tolhuin. Vamos a la empresa a relevar antes de proponer nada.',
  },
];
---

<Layout
  title={titulo}
  description={descripcion}
  path={path}
  noindex
  keywords="ingeniería de procesos Tierra del Fuego, mejora continua Ushuaia, lean manufacturing, 5S, kaizen, conteo de personas, mapa de calor, analítica de video Hikvision, integración tecnológica Ushuaia, automatización Río Grande"
  schemas={[
    breadcrumbSchema([{ name: 'Empresas', path }]),
    serviceSchema({
      nombre: 'Ingeniería de procesos e integración tecnológica',
      descripcion,
      path,
      tipo: 'Ingeniería de procesos, mejora continua y analítica de video',
      incluye: [
        'Relevamiento de procesos',
        '5S y estandarización',
        'Kaizen y mejora continua',
        'Gestión visual e indicadores',
        'Conteo de personas y mapas de calor',
        'Gestión de filas y control de aforo',
        'Automatización',
        'Integración de sistemas por API',
      ],
    }),
    faqSchema(faqs),
  ]}
>
  <Header heroOscuro />

  <main class="it">
    <!-- ── HERO ──────────────────────────────────────────────── -->
    <section class="relative bg-[#090B07] text-white overflow-hidden on-dark">
      <div class="it-grilla" aria-hidden="true"></div>
      <div class="wrap relative pt-32 pb-20 md:pt-44 md:pb-28">
        <div class="mb-8"><Breadcrumbs claro trail={[{ name: 'Empresas', path }]} /></div>
        <p class="eyebrow mb-6">PARA EMPRESAS · INGENIERÍA DE PROCESOS + TECNOLOGÍA</p>
        <h1 class="heading-hero max-w-5xl">
          Primero el proceso.<br /><span class="text-[#98C665]">Después la tecnología.</span>
        </h1>
        <p class="body-lead mt-8 max-w-2xl">
          Somos integradores tecnológicos de Tierra del Fuego. Ordenamos cómo trabaja
          tu empresa, lo medimos y recién ahí lo automatizamos. Ingeniería de
          procesos, analítica y tecnología con un mismo equipo.
        </p>
        <div class="mt-10 flex flex-wrap gap-4">
          <a href={wa} target="_blank" rel="noopener noreferrer" class="btn btn-primary">Contanos tu proceso</a>
          <a href="#metodo" class="btn btn-ghost">Cómo trabajamos</a>
        </div>
        <ul class="it-chips mt-14" aria-label="Lo que hacemos">
          {['Lean', '5S', 'Kaizen', 'Conteo de personas', 'Mapas de calor', 'Automatización', 'Integración de sistemas'].map((c) => (
            <li>{c}</li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ── EL PROBLEMA ───────────────────────────────────────── -->
    <section class="section section-dark on-dark">
      <div class="wrap">
        <div class="reveal max-w-3xl mb-14">
          <p class="eyebrow mb-4">EL PROBLEMA</p>
          <h2 class="heading-section text-white">La tecnología no arregla<br /><span class="text-[#98C665]">un problema de gestión.</span></h2>
          <p class="body-lead mt-6">
            Comprar otro sistema es fácil. Lo difícil es que sirva. Estas son las tres
            señales que más vemos cuando una empresa salta directo a la tecnología.
          </p>
        </div>
        <div class="grid md:grid-cols-3 gap-4">
          {sintomas.map((s, i) => (
            <article class={`reveal reveal-delay-${i + 1} it-card`}>
              <span class="it-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="heading-card text-white mt-4 mb-3">{s.titulo}</h3>
              <p class="body-text">{s.texto}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ── MÉTODO ────────────────────────────────────────────── -->
    <section id="metodo" class="section section-void on-dark scroll-mt-20">
      <div class="wrap grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20">
        <div class="reveal lg:sticky lg:top-28 self-start">
          <p class="eyebrow mb-4">CÓMO TRABAJAMOS</p>
          <h2 class="heading-section text-white">Cinco pasos,<br /><span class="text-[#98C665]">en este orden.</span></h2>
          <p class="body-lead mt-6">
            El orden importa. Cada paso se apoya en el anterior, y la tecnología
            llega al final, cuando ya sabemos qué hay que medir y qué conviene automatizar.
          </p>
        </div>
        <ol class="it-metodo" data-metodo>
          <span class="it-metodo-llena" aria-hidden="true"></span>
          {metodo.map((m, i) => (
            <li class="reveal it-paso" data-paso>
              <span class="it-nodo" aria-hidden="true"></span>
              <p class="eyebrow">{i + 1} · {m.clave}</p>
              <h3 class="heading-card text-white mt-2 !text-[clamp(1.35rem,2.6vw,1.9rem)]">{m.titulo}</h3>
              <p class="body-text mt-3 max-w-xl">{m.texto}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ── HERRAMIENTAS ──────────────────────────────────────── -->
    <section class="section section-dark on-dark">
      <div class="wrap">
        <div class="reveal max-w-3xl mb-12">
          <p class="eyebrow mb-4">INGENIERÍA DE PROCESOS</p>
          <h2 class="heading-section text-white">Las herramientas<br /><span class="text-[#98C665]">que aplicamos.</span></h2>
          <p class="body-lead mt-6">Tocá cada una para ver qué es y para qué te sirve.</p>
        </div>
        <div class="it-herr" data-tabs>
          <div class="it-tabs" role="tablist" aria-label="Herramientas">
            {herramientas.map((h, n) => (
              <button type="button" role="tab" class="it-tab" data-tab={n} aria-selected={n === 0 ? 'true' : 'false'}>{h.nombre}</button>
            ))}
          </div>
          {herramientas.map((h, n) => (
            <div class="it-panel" role="tabpanel" data-panel={n} aria-label={h.nombre}>
              <div class={`grid gap-8 ${h.conFoto ? 'md:grid-cols-[1.1fr_1fr] md:items-center' : ''}`}>
                {h.conFoto && (
                  <figure>
                    <img src={h.foto} alt={h.alt} class="it-foto aspect-[3/2]" width="960" height="640" loading="lazy" decoding="async" />
                    <figcaption class="it-credito">
                      Foto: {h.autor} · <a href={h.fuente} target="_blank" rel="noopener noreferrer">Wikimedia Commons</a> · <a href={h.licenciaUrl} target="_blank" rel="noopener noreferrer">{h.licencia}</a>
                    </figcaption>
                  </figure>
                )}
                <div>
                  <h3 class="heading-display text-[#98C665] !text-[clamp(2.4rem,7vw,4.5rem)]">{h.nombre}</h3>
                  <div class={`grid gap-6 mt-6 ${h.conFoto ? '' : 'md:grid-cols-2'}`}>
                    <div>
                      <p class="eyebrow mb-2">Qué es</p>
                      <p class="it-txt">{h.que}</p>
                    </div>
                    <div>
                      <p class="eyebrow mb-2">Para qué te sirve</p>
                      <p class="it-txt text-white">{h.sirve}</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── ANALÍTICA ─────────────────────────────────────────── -->
    <section class="section section-void on-dark">
      <div class="wrap">
        <div class="reveal max-w-3xl mb-12">
          <p class="eyebrow mb-4">MEDIR · ANALÍTICA DE VIDEO</p>
          <h2 class="heading-section text-white">Cámaras que<br /><span class="text-[#98C665]">cuentan, no solo graban.</span></h2>
          <p class="body-lead mt-6">
            Con la línea de inteligencia artificial de Hikvision, una cámara pasa a ser
            un sensor del negocio: cuenta personas, mide filas y muestra por dónde
            circula la gente. Elegí la zona que querés medir.
          </p>
        </div>

        <div class="it-herr" data-tabs>
          <div class="it-tabs" role="tablist" aria-label="Zona a medir">
            {camaras.map((c, n) => (
              <button type="button" role="tab" class="it-tab" data-tab={n} aria-selected={n === 0 ? 'true' : 'false'}>{c.zona}</button>
            ))}
          </div>
          {camaras.map((c, n) => (
            <div class="it-panel" role="tabpanel" data-panel={n} aria-label={c.zona}>
              <div class="grid gap-8 md:grid-cols-[1.25fr_1fr] md:items-start">
                <img src={c.escena.src} alt={c.escena.alt} class="it-foto aspect-video" width={c.escena.w} height={c.escena.h} loading="lazy" decoding="async" />
                <div>
                  <p class="eyebrow mb-3">{c.para}</p>
                  <h3 class="heading-section text-white !text-[clamp(1.9rem,4.5vw,3rem)]">{c.tipo}</h3>
                  <p class="it-txt mt-5">{c.texto}</p>
                  <div class="it-producto mt-6">
                    {c.producto && (
