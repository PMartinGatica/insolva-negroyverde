  .it-metodo::before { background: repeating-linear-gradient(to bottom, rgb(152 198 101 / 0.45) 0 4px, transparent 4px 11px); }
  .it-metodo-llena { background: var(--green); transform: scaleY(var(--avance, 0)); transform-origin: top; }
