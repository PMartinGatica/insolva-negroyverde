---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Hero from '../components/sections/Hero.astro';
// Sección scroll-driven de la casa construyéndose — video orbital 360° (140 frames WebP).
// Regenerar: node scripts/build-frames.mjs assets/source/casa-construccion.mp4 construccion 140
import ConstruccionScroll from '../components/sections/ConstruccionScroll.astro';
import Clientes from '../components/sections/Clientes.astro';
import Pilares from '../components/sections/Pilares.astro';
import PlanificacionObra from '../components/sections/PlanificacionObra.astro';
import Ushuaia from '../components/sections/Ushuaia.astro';
import Guias from '../components/sections/Guias.astro';
import WhatsAppFloat from '../components/ui/WhatsAppFloat.astro';
import CookieBanner from '../components/ui/CookieBanner.astro';
import { whatsappLink } from '../lib/whatsapp';

/*
  La home presenta la empresa y deriva. Nada de contenido completo acá: los
  servicios con sus fotos viven en /servicios, las instalaciones y los videos
  en /trabajos, la empresa en /nosotros y las vías de contacto en /contacto.
  Antes era una landing única que repetía las mismas fotos y los mismos textos
  que después mostraban las páginas internas.

  Secciones fuera de página (siguen en el repo, ver estado.md):
  Tienda (va al WooCommerce aparte), Beneficios, Confianza, Galeria, Calculadora,
  Embudo y ChatAsistente (estos dos necesitan servidor).
*/
const wa = whatsappLink({ source: 'contacto' });
---

<Layout>
  <Header heroOscuro />
  <main>
    <Hero />
    <Clientes />
    <ConstruccionScroll />
    <Pilares />
    <PlanificacionObra />
    <Ushuaia />
    <Guias />

    <!-- ── CTA FINAL ────────────────────────────────────────── -->
    <section class="section section-void on-dark">
      <div class="wrap max-w-3xl">
        <div class="reveal">
          <h2 class="heading-display text-white">
            ¿Tenés una obra,<br />una casa o un negocio?
          </h2>
          <p class="body-lead mt-6">
            Contanos qué necesitás y analizamos la mejor forma de resolverlo. El
            relevamiento y el presupuesto no tienen cargo.
          </p>
          <div class="mt-9 flex flex-wrap items-center gap-4">
            <a href={wa} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
              Hablar con INSOLVA
            </a>
            <a href="/trabajos/" class="btn btn-ghost">Ver trabajos</a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <WhatsAppFloat />
  <CookieBanner />
</Layout>
