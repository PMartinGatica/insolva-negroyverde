---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import PageHero from '../components/layout/PageHero.astro';
import FormContacto from '../components/ui/FormContacto.astro';
import Newsletter from '../components/ui/Newsletter.astro';
import WhatsAppFloat from '../components/ui/WhatsAppFloat.astro';
import CookieBanner from '../components/ui/CookieBanner.astro';
import { BRAND } from '../lib/constants';
import { CANAL_URL } from '../lib/videos';
import { whatsappLink } from '../lib/whatsapp';
import { funnelLink } from '../lib/funnel';
import { breadcrumbSchema } from '../lib/seo';

const path = '/contacto';
const wa = whatsappLink({ source: 'contacto' });

const canales = [
  {
    nombre: 'WhatsApp',
    detalle: BRAND.whatsappLegible,
    pie: 'La vía más rápida. Respondemos en el día.',
    href: wa,
    externo: true,
    icono: 'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z',
  },
  {
    nombre: 'Correo',
    detalle: BRAND.email,
    pie: 'Para presupuestos largos, planos o documentación.',
    href: `mailto:${BRAND.email}`,
    externo: false,
    icono: 'M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 4-8 5-8-5V6l8 5 8-5z',
  },
  {
    nombre: 'Instagram',
    detalle: BRAND.instagram,
    pie: 'Trabajos del día a día y novedades.',
    href: BRAND.instagramUrl,
    externo: true,
    icono: 'M12 2.2c3.2 0 3.6 0 4.9.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.3.07 1.69.07 4.9s0 3.6-.07 4.9c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.3.06-1.69.07-4.9.07s-3.6 0-4.9-.07c-1.17-.05-1.8-.25-2.23-.41-.56-.22-.96-.48-1.38-.9-.42-.42-.68-.82-.9-1.38-.16-.42-.36-1.06-.41-2.23C2.2 15.6 2.2 15.2 2.2 12s0-3.6.07-4.9c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.4 2.2 8.8 2.2 12 2.2zm0 5.1a4.7 4.7 0 1 0 0 9.4 4.7 4.7 0 0 0 0-9.4zm0 7.75a3.05 3.05 0 1 1 0-6.1 3.05 3.05 0 0 1 0 6.1zm5.99-7.94a1.1 1.1 0 1 1-2.2 0 1.1 1.1 0 0 1 2.2 0z',
  },
  {
    nombre: 'YouTube',
    detalle: '@insolva',
    pie: 'Videos cortos de instalaciones reales.',
    href: CANAL_URL,
    externo: true,
    icono: 'M23.5 6.2a3 3 0 0 0-2.12-2.13C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.52A3 3 0 0 0 .5 6.2 31.4 31.4 0 0 0 0 12a31.4 31.4 0 0 0 .5 5.8 3 3 0 0 0 2.12 2.13c1.88.52 9.38.52 9.38.52s7.5 0 9.38-.52a3 3 0 0 0 2.12-2.13A31.4 31.4 0 0 0 24 12a31.4 31.4 0 0 0-.5-5.8zM9.55 15.57V8.43L15.82 12l-6.27 3.57z',
  },
];

const schemas = [breadcrumbSchema([{ name: 'Contacto', path }])];
---

<Layout
  title="Contacto | Presupuestos de Seguridad Electrónica en Ushuaia | INSOLVA Group"
  description="Pedí tu presupuesto de cámaras, alarmas, cerraduras digitales, domótica, redes o electricidad en Ushuaia, Río Grande y Tolhuin. WhatsApp, correo y formulario."
  path={path}
  keywords="contacto INSOLVA Ushuaia, presupuesto cámaras Ushuaia, empresa de seguridad electrónica Tierra del Fuego contacto, electricista Ushuaia teléfono"
  schemas={schemas}
>
  <Header heroOscuro />

  <main>
    <PageHero
      eyebrow="CONTACTO · TIERRA DEL FUEGO"
      titulo="Contanos"
      destacado="qué necesitás."
      lead="Escribinos por donde te quede más cómodo. Si nos decís dónde es y qué querés resolver, coordinamos un relevamiento y te pasamos un presupuesto hecho para tu lugar."
      trail={[{ name: 'Contacto', path }]}
    />

    <!-- ── CANALES ──────────────────────────────────────────── -->
    <section class="section section-light">
      <div class="wrap">
        <div class="reveal max-w-2xl mb-12">
          <p class="eyebrow mb-4">POR DÓNDE HABLAMOS</p>
          <h2 class="heading-section text-[#11140F]">Elegí el canal<br />que prefieras.</h2>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-x-10">
          {canales.map((canal, i) => (
            <a
              href={canal.href}
              target={canal.externo ? '_blank' : undefined}
              rel={canal.externo ? 'noopener noreferrer' : undefined}
              class={`reveal reveal-delay-${(i % 3) + 1} group block border-t border-[#11140F]/12 pt-7 pb-6 hover:border-[#98C665] transition-colors`}
            >
              <span class="text-[#4F7D22] block mb-4" aria-hidden="true">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d={canal.icono} /></svg>
              </span>
              <h3 class="heading-card text-[#11140F] mb-2 group-hover:text-[#4F7D22] transition-colors">{canal.nombre}</h3>
              <p class="body-text text-sm mb-2 break-words">{canal.detalle}</p>
              <p class="body-text text-sm opacity-80">{canal.pie}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ── FORMULARIO + DATOS ───────────────────────────────── -->
    <section class="section section-paper">
      <div class="wrap grid gap-12 lg:grid-cols-[1.3fr_1fr] lg:gap-20">

        <div class="reveal">
          <p class="eyebrow mb-4">FORMULARIO</p>
          <h2 class="heading-section text-[#11140F] mb-4">Dejanos los datos.</h2>
          <p class="body-text mb-9 max-w-xl">
            Con el nombre y un WhatsApp alcanza. El resto nos ayuda a llegar con
            una idea armada.
          </p>
          <FormContacto />
        </div>

        <aside class="reveal reveal-delay-1 self-start">
          <div class="border-t border-[#11140F]/12 pt-7">
            <h3 class="heading-card text-[#11140F] mb-3">Dónde trabajamos</h3>
            <p class="body-text">
              Ushuaia, Río Grande y Tolhuin.<br />
              Tierra del Fuego, Argentina.
            </p>
          </div>

          <div class="border-t border-[#11140F]/12 pt-7 mt-8">
            <h3 class="heading-card text-[#11140F] mb-3">Horario de oficina</h3>
            <p class="body-text">
              Lunes a viernes, de 9 a 18.<br />
              Por WhatsApp leemos fuera de ese horario.
            </p>
          </div>

          <div class="border-t border-[#11140F]/12 pt-7 mt-8">
            <h3 class="heading-card text-[#11140F] mb-3">Sobre los presupuestos</h3>
            <p class="body-text">
              El relevamiento y el presupuesto no tienen cargo. No vendemos
              paquetes cerrados: el precio sale de lo que necesite tu lugar.
            </p>
          </div>

          <div class="border-t border-[#11140F]/12 pt-7 mt-8">
            <h3 class="heading-card text-[#11140F] mb-3">Guías gratis</h3>
            <p class="body-text">
              Guías para elegir, un curso de domótica y fichas técnicas de
              cerraduras. Dejás tus datos y se abre todo.
            </p>
            <a href={funnelLink('contacto')} target="_blank" rel="noopener noreferrer" class="link-arrow mt-4">
              Quiero las guías <span aria-hidden="true">→</span>
            </a>
          </div>

          <div class="mt-9">
            <a href={wa} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
              Escribir por WhatsApp
            </a>
          </div>
        </aside>

      </div>
    </section>

    <Newsletter variante="dark" />
  </main>

  <Footer />
  <WhatsAppFloat />
  <CookieBanner />
</Layout>
