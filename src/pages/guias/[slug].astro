---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import WhatsAppFloat from '../../components/ui/WhatsAppFloat.astro';
import CookieBanner from '../../components/ui/CookieBanner.astro';
import GuiaBloque from '../../components/guias/GuiaBloque.astro';
import {
  GUIAS,
  GUIAS_ACTUALIZADAS,
  GUIAS_PUBLICADAS,
  interesDe,
  leccionesDe,
  relacionadosDe,
  textoPlano,
  tituloDe,
  type Guia,
} from '../../lib/guias';
import { getServicio } from '../../lib/servicios';
import { articleSchema, breadcrumbSchema } from '../../lib/seo';
import { funnelLink } from '../../lib/funnel';
import { whatsappLink } from '../../lib/whatsapp';

export function getStaticPaths() {
  return GUIAS.map((guia) => ({ params: { slug: guia.slug }, props: { guia } }));
}

const { guia } = Astro.props as { guia: Guia };

const path = `/guias/${guia.slug}`;
const titulo = tituloDe(guia);
const lecciones = leccionesDe(guia);
const esFicha = guia.formato === 'Ficha técnica';
const relacionados = relacionadosDe(guia);
const trail = [
  { name: 'Guías', path: '/guias' },
  { name: guia.titulo, path },
];

// Servicios relacionados, sin repetir (obra y electricidad apuntan al mismo).
const servicios = [...new Set(guia.intereses.map((i) => interesDe(i).servicio))]
  .map((slug) => getServicio(slug))
  .filter((s): s is NonNullable<typeof s> => s !== undefined);

// Número de lección vigente para cada bloque (las lecciones se numeran en orden).
const numeros = guia.bloques.reduce<number[]>((acc, b) => {
  const previo = acc.length ? acc[acc.length - 1] : 0;
  acc.push(b.tipo === 'leccion' ? previo + 1 : previo);
  return acc;
}, []);

// Escenas, como las tomas de un reel: cada subtítulo ("h") o lección abre una
// escena nueva; lo que viene antes del primero es la introducción.
type Escena = { titulo?: string; esLeccion: boolean; n: number; items: { b: Guia['bloques'][number]; i: number }[] };
const escenas: Escena[] = [{ esLeccion: false, n: 0, items: [] }];
guia.bloques.forEach((b, i) => {
  if (b.tipo === 'h' || b.tipo === 'leccion') {
    escenas.push({
      titulo: b.tipo === 'h' ? b.texto : undefined,
      esLeccion: b.tipo === 'leccion',
      n: escenas.length,
      items: b.tipo === 'leccion' ? [{ b, i }] : [],
    });
  } else {
    escenas[escenas.length - 1].items.push({ b, i });
  }
});
if (escenas[0].items.length === 0) escenas.shift();

const wa = whatsappLink({ message: guia.consulta });
const grupo = funnelLink(`guia-${guia.slug}`);
const palabras = textoPlano(guia).split(/\s+/).filter(Boolean).length;
const temas = guia.intereses.map((i) => interesDe(i).label);
---

<Layout
  title={`${titulo} | Guías INSOLVA Group`}
  description={guia.bajada}
  path={path}
  keywords={[...temas, 'Ushuaia', 'Tierra del Fuego', guia.formato.toLowerCase()].join(', ')}
  schemas={[
    breadcrumbSchema(trail),
    articleSchema({
      titulo,
      descripcion: guia.bajada,
      path,
      imagen: guia.portada?.src,
      publicado: GUIAS_PUBLICADAS,
      actualizado: GUIAS_ACTUALIZADAS,
      palabras,
      seccion: guia.formato,
      temas,
      servicios: servicios.map((s) => s.slug),
    }),
  ]}
>
  <Header heroOscuro />

  <main>
    <!-- ── CABECERA ──────────────────────────────────────────── -->
    <section class="relative bg-[#11140F] text-white overflow-hidden on-dark">
      {guia.portada && (
        <>
          <div class="absolute inset-y-0 right-0 w-full md:w-[55%]" aria-hidden="true">
            <img src={guia.portada.src} alt="" class="w-full h-full object-cover opacity-30 md:opacity-70" width="1200" height="800" fetchpriority="high" decoding="async" />
          </div>
          <div class="absolute inset-0 bg-[#090B07]/65 md:hidden" aria-hidden="true"></div>
          <div class="absolute inset-0 hidden md:block bg-gradient-to-r from-[#090B07] from-40% via-[#090B07]/70 via-62% to-[#090B07]/10" aria-hidden="true"></div>
        </>
      )}
      <div class="wrap relative pt-32 pb-14 md:pt-44 md:pb-20">
        <div class="mb-8"><Breadcrumbs claro trail={trail} /></div>
        <p class="eyebrow mb-5">
          {guia.formato.toUpperCase()} · {lecciones.length > 0 ? `${lecciones.length} LECCIONES · ` : ''}{guia.minutos} MIN DE LECTURA
        </p>
        <h1 class="heading-display max-w-3xl !text-[clamp(2.2rem,5.5vw,4.4rem)]">{titulo}</h1>
        <p class="body-lead mt-6 max-w-2xl">{guia.bajada}</p>
      </div>
    </section>

    <!-- ── CONTENIDO ─────────────────────────────────────────── -->
    <div class="g-progreso" aria-hidden="true"><span id="guia-progreso"></span></div>

    <section class="section section-dark on-dark !pt-14">
      <div class="wrap max-w-3xl">
        {guia.portada && (
          <figure class="reveal mb-12">
            <img src={guia.portada.src} alt={guia.portada.alt} class="w-full aspect-[16/9] object-cover rounded-lg" width="1200" height="675" loading="lazy" decoding="async" />
          </figure>
        )}

        {lecciones.length > 0 && (
          <nav aria-label="Lecciones del curso" class="mb-12 rounded-xl border border-white/12 bg-white/[0.03] p-5 sm:p-6">
            <p class="eyebrow">Lecciones</p>
            <ol class="mt-3 flex flex-col">
              {lecciones.map((l, i) => (
                <li>
                  <a href={`#leccion-${i + 1}`} class="flex min-h-11 items-center gap-3 border-b border-white/10 py-2 text-white last:border-0 hover:text-[#98C665] transition-colors">
                    <span class="heading-card !text-sm text-[#98C665]">{String(i + 1).padStart(2, '0')}</span>
                    {l}
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        )}

        <!-- La historia: escenas unidas por una línea que se llena al bajar. -->
        <article class="g-historia" data-historia>
          <span class="g-linea-llena" aria-hidden="true"></span>
          {escenas.map((e) => (
            <section class="g-escena" data-escena id={e.titulo ? `paso-${e.n}` : undefined}>
              <span class="g-nodo" aria-hidden="true"></span>
              {e.titulo && (
                <div class="reveal mb-6">
                  <p class="eyebrow">{String(e.n).padStart(2, '0')} · {guia.formato === 'Checklist' ? 'Revisá' : 'Paso'}</p>
                  <h2 class="heading-section text-white mt-3 !text-[clamp(1.9rem,5vw,3.2rem)]">{e.titulo}</h2>
                </div>
              )}
              <div class="flex flex-col gap-6">
                {e.items.map(({ b, i }) => (
                  <GuiaBloque bloque={b} numero={numeros[i]} clave={`${guia.slug}-${i}`} />
                ))}
              </div>
            </section>
          ))}
        </article>

        {esFicha && (
          <div class="mt-12 rounded-xl border border-white/12 bg-white/[0.03] p-6 sm:p-8">
            <h2 class="heading-card text-white !text-[1.2rem]">Hoja de datos del fabricante</h2>
            <p class="body-text mt-2">
              Medidas, espesores de puerta compatibles, consumo y garantía, tal como los publica el fabricante.
            </p>
            <div class="mt-5 flex flex-wrap gap-3">
              {guia.pdf ? (
                <a href={guia.pdf} download class="btn btn-primary">Descargar PDF</a>
              ) : (
                <a href={wa} target="_blank" rel="noopener noreferrer" class="btn btn-primary">Pedir la hoja de datos</a>
              )}
              {guia.tiendaUrl && (
                <a href={guia.tiendaUrl} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">Ver en la tienda</a>
              )}
            </div>
          </div>
        )}

        <!-- Firma: quién escribe y desde dónde (señal de experiencia local). -->
        <p class="mt-12 border-t border-white/12 pt-6 text-sm text-[#AFB2AD]" style="font-family:'Space Grotesk',sans-serif;">
          Escrita por el equipo técnico de INSOLVA Group, instaladores en Ushuaia, Río Grande y Tolhuin.
          Actualizada el <time datetime={GUIAS_ACTUALIZADAS}>{new Date(`${GUIAS_ACTUALIZADAS}T12:00:00`).toLocaleDateString('es-AR', { day: 'numeric', month: 'long', year: 'numeric' })}</time>.
        </p>

        <!-- ── CONSULTA ─────────────────────────────────────────── -->
        <div class="mt-8 rounded-xl border border-[#98C665]/40 bg-[#98C665]/[0.07] text-white p-6 sm:p-8 on-dark">
          <p class="eyebrow mb-3">¿LO VEMOS EN TU CASA O NEGOCIO?</p>
          <p class="body-text">
            Si después de leer te quedan dudas, contanos qué tenés y te decimos qué conviene.
            El presupuesto no tiene costo y te respondemos en el día.
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href={wa} target="_blank" rel="noopener noreferrer" class="btn btn-primary">Consultar por WhatsApp</a>
            {servicios[0] && <a href={`/${servicios[0].slug}/`} class="btn btn-ghost">Ver {servicios[0].nav.toLowerCase()}</a>}
          </div>
        </div>
      </div>
    </section>

    <!-- ── SEGUÍ CON ─────────────────────────────────────────── -->
    <section class="section section-paper">
      <div class="wrap grid gap-12 lg:grid-cols-[1fr_22rem] lg:gap-16">
        <div>
          <p class="eyebrow mb-4">SEGUÍ CON</p>
          <ul class="border-t border-[#11140F]/12">
            {relacionados.map((g) => (
              <li class="border-b border-[#11140F]/12">
                <a href={`/guias/${g.slug}/`} class="group block py-5">
                  <span class="text-xs text-[#72766F] uppercase tracking-[0.16em]" style="font-family:'enma',sans-serif;">{g.formato} · {g.minutos} min</span>
                  <h2 class="heading-card text-[#11140F] mt-1 group-hover:text-[var(--green-text)] transition-colors">{tituloDe(g)}</h2>
                </a>
              </li>
            ))}
          </ul>
          <a href="/guias/" class="link-arrow mt-6">Todas las guías <span aria-hidden="true">→</span></a>
        </div>

        <aside class="border border-[#11140F]/12 bg-white p-6 sm:p-8 self-start">
          <p class="eyebrow mb-3">GRUPO DE BENEFICIOS</p>
          <p class="heading-card text-[#11140F] !text-[1.15rem]">Las guías nuevas y las promos, primero.</p>
          <p class="body-text mt-3">
            Grupo de avisos de WhatsApp: publicamos nosotros y salís cuando quieras.
          </p>
          <a href={grupo} target="_blank" rel="noopener noreferrer" class="btn btn-primary mt-6">Sumarme al grupo</a>
          {servicios.length > 0 && (
            <>
              <p class="eyebrow mt-8 mb-3">SERVICIOS RELACIONADOS</p>
              <ul class="flex flex-col gap-2">
                {servicios.map((s) => (
                  <li><a href={`/${s.slug}/`} class="link-arrow">{s.nav} <span aria-hidden="true">→</span></a></li>
                ))}
              </ul>
            </>
          )}
        </aside>
      </div>
    </section>
  </main>

  <Footer />
  <WhatsAppFloat />
  <CookieBanner />
</Layout>

<style>
  /* Barra fina arriba de todo: cuánto de la guía ya leíste. */
  .g-progreso {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    z-index: 60;
    pointer-events: none;
  }
  .g-progreso span {
    display: block;
    height: 100%;
    background: var(--green);
    transform: scaleX(var(--avance, 0));
    transform-origin: left;
  }

  /* La historia: una línea punteada a la izquierda que une las escenas, y una
     línea verde llena que avanza con el scroll, como el cable del reel. */
  .g-historia {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 4.5rem;
    padding-left: 1.75rem;
  }
  @media (min-width: 768px) {
    .g-historia { padding-left: 3rem; gap: 6rem; }
  }
  .g-historia::before,
  .g-linea-llena {
    content: '';
    position: absolute;
    left: 5px;
    top: 0.5rem;
    bottom: 0;
    width: 2px;
  }
  .g-historia::before {
    background: repeating-linear-gradient(to bottom, rgb(152 198 101 / 0.45) 0 4px, transparent 4px 11px);
  }
  .g-linea-llena {
    background: var(--green);
    transform: scaleY(var(--avance, 0));
    transform-origin: top;
  }
  .g-escena { position: relative; }
  .g-nodo {
    position: absolute;
    left: calc(-1.75rem + 6px - 7px);
    top: 0.35rem;
    width: 14px;
    height: 14px;
    border-radius: 999px;
    background: #11140F;
    border: 2px solid rgb(152 198 101 / 0.6);
    transition: background 0.35s, border-color 0.35s, box-shadow 0.35s;
  }
  @media (min-width: 768px) {
    .g-nodo { left: calc(-3rem + 6px - 7px); }
  }
  .g-escena.activa .g-nodo {
    background: var(--green);
    border-color: var(--green);
  }
</style>

<script>
  // Avance de lectura: barra de arriba, línea llena y escena activa.
  const historia = document.querySelector<HTMLElement>('[data-historia]');
  const escenas = Array.from(document.querySelectorAll<HTMLElement>('[data-escena]'));
  let pendiente = false;

  function medir() {
    pendiente = false;
    if (!historia) return;
    const vh = window.innerHeight;
    const r = historia.getBoundingClientRect();
    const avance = Math.min(1, Math.max(0, (vh * 0.6 - r.top) / r.height));
    historia.style.setProperty('--avance', String(avance));
    const total = document.documentElement.scrollHeight - vh;
    const leido = total > 0 ? Math.min(1, window.scrollY / total) : 0;
    document.documentElement.style.setProperty('--avance', String(leido));
    escenas.forEach((e) => e.classList.toggle('activa', e.getBoundingClientRect().top < vh * 0.6));
  }
  function pedir() {
    if (!pendiente) {
      pendiente = true;
      requestAnimationFrame(medir);
    }
  }
  window.addEventListener('scroll', pedir, { passive: true });
  window.addEventListener('resize', pedir);
  medir();

  // Checklists: se tildan y quedan guardados en este navegador.
  document.querySelectorAll<HTMLElement>('[data-check]').forEach((box) => {
    const clave = `insolva-guia-${box.dataset.check}`;
    const items = Array.from(box.querySelectorAll<HTMLInputElement>('[data-check-item]'));
    const cuenta = box.querySelector('[data-check-cuenta]');
    const barra = box.querySelector<HTMLElement>('[data-check-barra]');
    const listo = box.querySelector<HTMLElement>('[data-check-listo]');
    try {
      const guardado = JSON.parse(localStorage.getItem(clave) ?? '[]');
      if (Array.isArray(guardado)) items.forEach((it, i) => (it.checked = Boolean(guardado[i])));
    } catch {}
    const actualizar = () => {
      const n = items.filter((it) => it.checked).length;
      if (cuenta) cuenta.textContent = String(n);
      if (barra) barra.style.transform = `scaleX(${items.length ? n / items.length : 0})`;
      if (listo) listo.hidden = n !== items.length;
    };
    items.forEach((it) =>
      it.addEventListener('change', () => {
        actualizar();
        try {
          localStorage.setItem(clave, JSON.stringify(items.map((x) => x.checked)));
        } catch {}
      })
    );
    actualizar();
  });

  // Comparativas: una opción a la vez, con pestañas.
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((comp) => {
    const tabs = Array.from(comp.querySelectorAll<HTMLButtonElement>('[data-tab]'));
    const paneles = Array.from(comp.querySelectorAll<HTMLElement>('[data-panel]'));
    const elegir = (n: number) => {
      tabs.forEach((t, i) => t.setAttribute('aria-selected', String(i === n)));
      paneles.forEach((p, i) => (p.hidden = i !== n));
    };
    tabs.forEach((t, i) => t.addEventListener('click', () => elegir(i)));
    elegir(0);
  });
</script>
