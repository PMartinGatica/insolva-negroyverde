---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import WhatsAppFloat from '../../components/ui/WhatsAppFloat.astro';
import CookieBanner from '../../components/ui/CookieBanner.astro';
import GuiaBloque from '../../components/guias/GuiaBloque.astro';
import {
  GUIAS,
  GUIAS_ACTUALIZADAS,
  GUIAS_PUBLICADAS,
  interesDe,
  leccionesDe,
  relacionadosDe,
  textoPlano,
  tituloDe,
  type Guia,
} from '../../lib/guias';
import { getServicio } from '../../lib/servicios';
import { articleSchema, breadcrumbSchema } from '../../lib/seo';
import { funnelLink } from '../../lib/funnel';
import { whatsappLink } from '../../lib/whatsapp';

export function getStaticPaths() {
  return GUIAS.map((guia) => ({ params: { slug: guia.slug }, props: { guia } }));
}

const { guia } = Astro.props as { guia: Guia };

const path = `/guias/${guia.slug}`;
const titulo = tituloDe(guia);
const lecciones = leccionesDe(guia);
const esFicha = guia.formato === 'Ficha técnica';
const relacionados = relacionadosDe(guia);
const trail = [
  { name: 'Guías', path: '/guias' },
  { name: guia.titulo, path },
];

// Servicios relacionados, sin repetir (obra y electricidad apuntan al mismo).
const servicios = [...new Set(guia.intereses.map((i) => interesDe(i).servicio))]
  .map((slug) => getServicio(slug))
  .filter((s) => s !== undefined);

// Número de lección vigente para cada bloque (las lecciones se numeran en orden).
const numeros = guia.bloques.reduce<number[]>((acc, b) => {
  const previo = acc.length ? acc[acc.length - 1] : 0;
  acc.push(b.tipo === 'leccion' ? previo + 1 : previo);
  return acc;
}, []);

const wa = whatsappLink({ message: guia.consulta });
const grupo = funnelLink(`guia-${guia.slug}`);
const palabras = textoPlano(guia).split(/\s+/).filter(Boolean).length;
const temas = guia.intereses.map((i) => interesDe(i).label);
---

<Layout
  title={`${titulo} | Guías INSOLVA Group`}
  description={guia.bajada}
  path={path}
  keywords={[...temas, 'Ushuaia', 'Tierra del Fuego', guia.formato.toLowerCase()].join(', ')}
  schemas={[
    breadcrumbSchema(trail),
    articleSchema({
      titulo,
      descripcion: guia.bajada,
      path,
      imagen: guia.portada?.src,
      publicado: GUIAS_PUBLICADAS,
      actualizado: GUIAS_ACTUALIZADAS,
      palabras,
      seccion: guia.formato,
      temas,
      servicios: servicios.map((s) => s.slug),
    }),
  ]}
>
  <Header heroOscuro />

  <main>
    <!-- ── CABECERA ──────────────────────────────────────────── -->
    <section class="relative bg-[#11140F] text-white overflow-hidden on-dark">
      {guia.portada && (
        <>
          <div class="absolute inset-y-0 right-0 w-full md:w-[55%]" aria-hidden="true">
            <img src={guia.portada.src} alt="" class="w-full h-full object-cover opacity-30 md:opacity-70" width="1200" height="800" fetchpriority="high" decoding="async" />
          </div>
          <div class="absolute inset-0 bg-[#090B07]/65 md:hidden" aria-hidden="true"></div>
          <div class="absolute inset-0 hidden md:block bg-gradient-to-r from-[#090B07] from-40% via-[#090B07]/70 via-62% to-[#090B07]/10" aria-hidden="true"></div>
        </>
      )}
      <div class="wrap relative pt-32 pb-14 md:pt-44 md:pb-20">
        <div class="mb-8"><Breadcrumbs claro trail={trail} /></div>
        <p class="eyebrow mb-5">
          {guia.formato.toUpperCase()} · {lecciones.length > 0 ? `${lecciones.length} LECCIONES · ` : ''}{guia.minutos} MIN DE LECTURA
        </p>
        <h1 class="heading-display max-w-3xl !text-[clamp(2.2rem,5.5vw,4.4rem)]">{titulo}</h1>
        <p class="body-lead mt-6 max-w-2xl">{guia.bajada}</p>
      </div>
    </section>

    <!-- ── CONTENIDO ─────────────────────────────────────────── -->
    <section class="section section-light !pt-14">
      <div class="wrap max-w-3xl">
        {guia.portada && (
          <figure class="mb-10">
            <img src={guia.portada.src} alt={guia.portada.alt} class="w-full aspect-[16/9] object-cover" width="1200" height="675" loading="lazy" decoding="async" />
          </figure>
        )}

        {lecciones.length > 0 && (
          <nav aria-label="Lecciones del curso" class="mb-10 border border-[#11140F]/12 bg-white p-5 sm:p-6">
            <p class="eyebrow">Lecciones</p>
            <ol class="mt-3 flex flex-col">
              {lecciones.map((l, i) => (
                <li>
                  <a href={`#leccion-${i + 1}`} class="flex min-h-11 items-center gap-3 border-b border-[#11140F]/12 py-2 text-[#11140F] last:border-0 hover:text-[var(--green-text)] transition-colors">
                    <span class="heading-card !text-sm text-[var(--green-text)]">{String(i + 1).padStart(2, '0')}</span>
                    {l}
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        )}

        <article class="flex flex-col gap-6">
          {guia.bloques.map((b, i) => <GuiaBloque bloque={b} numero={numeros[i]} />)}
        </article>

        {esFicha && (
          <div class="mt-12 border border-[#11140F]/12 bg-white p-6 sm:p-8">
            <h2 class="heading-card text-[#11140F] !text-[1.2rem]">Hoja de datos del fabricante</h2>
            <p class="body-text mt-2">
              Medidas, espesores de puerta compatibles, consumo y garantía, tal como los publica el fabricante.
            </p>
            <div class="mt-5 flex flex-wrap gap-3">
              {guia.pdf ? (
                <a href={guia.pdf} download class="btn btn-primary">Descargar PDF</a>
              ) : (
                <a href={wa} target="_blank" rel="noopener noreferrer" class="btn btn-primary">Pedir la hoja de datos</a>
              )}
              {guia.tiendaUrl && (
                <a href={guia.tiendaUrl} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">Ver en la tienda</a>
              )}
            </div>
          </div>
        )}

        <!-- Firma: quién escribe y desde dónde (señal de experiencia local). -->
        <p class="mt-12 border-t border-[#11140F]/12 pt-6 text-sm text-[#72766F]" style="font-family:'Space Grotesk',sans-serif;">
          Escrita por el equipo técnico de INSOLVA Group, instaladores en Ushuaia, Río Grande y Tolhuin.
          Actualizada el <time datetime={GUIAS_ACTUALIZADAS}>{new Date(`${GUIAS_ACTUALIZADAS}T12:00:00`).toLocaleDateString('es-AR', { day: 'numeric', month: 'long', year: 'numeric' })}</time>.
        </p>

        <!-- ── CONSULTA ─────────────────────────────────────────── -->
        <div class="mt-8 bg-[#11140F] text-white p-6 sm:p-8 on-dark">
          <p class="eyebrow mb-3">¿LO VEMOS EN TU CASA O NEGOCIO?</p>
          <p class="body-text">
            Si después de leer te quedan dudas, contanos qué tenés y te decimos qué conviene.
            El presupuesto no tiene costo y te respondemos en el día.
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href={wa} target="_blank" rel="noopener noreferrer" class="btn btn-primary">Consultar por WhatsApp</a>
            {servicios[0] && <a href={`/${servicios[0].slug}/`} class="btn btn-ghost">Ver {servicios[0].nav.toLowerCase()}</a>}
          </div>
        </div>
      </div>
    </section>

    <!-- ── SEGUÍ CON ─────────────────────────────────────────── -->
    <section class="section section-paper">
      <div class="wrap grid gap-12 lg:grid-cols-[1fr_22rem] lg:gap-16">
        <div>
          <p class="eyebrow mb-4">SEGUÍ CON</p>
          <ul class="border-t border-[#11140F]/12">
            {relacionados.map((g) => (
              <li class="border-b border-[#11140F]/12">
                <a href={`/guias/${g.slug}/`} class="group block py-5">
                  <span class="text-xs text-[#72766F] uppercase tracking-[0.16em]" style="font-family:'enma',sans-serif;">{g.formato} · {g.minutos} min</span>
                  <h2 class="heading-card text-[#11140F] mt-1 group-hover:text-[var(--green-text)] transition-colors">{tituloDe(g)}</h2>
                </a>
              </li>
            ))}
          </ul>
          <a href="/guias/" class="link-arrow mt-6">Todas las guías <span aria-hidden="true">→</span></a>
        </div>

        <aside class="border border-[#11140F]/12 bg-white p-6 sm:p-8 self-start">
          <p class="eyebrow mb-3">GRUPO DE BENEFICIOS</p>
          <p class="heading-card text-[#11140F] !text-[1.15rem]">Las guías nuevas y las promos, primero.</p>
          <p class="body-text mt-3">
            Grupo de avisos de WhatsApp: publicamos nosotros y salís cuando quieras.
          </p>
          <a href={grupo} target="_blank" rel="noopener noreferrer" class="btn btn-primary mt-6">Sumarme al grupo</a>
          {servicios.length > 0 && (
            <>
              <p class="eyebrow mt-8 mb-3">SERVICIOS RELACIONADOS</p>
              <ul class="flex flex-col gap-2">
                {servicios.map((s) => (
                  <li><a href={`/${s.slug}/`} class="link-arrow">{s.nav} <span aria-hidden="true">→</span></a></li>
                ))}
              </ul>
            </>
          )}
        </aside>
      </div>
    </section>
  </main>

  <Footer />
  <WhatsAppFloat />
  <CookieBanner />
</Layout>
