---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import PageHero from '../components/layout/PageHero.astro';
import Foto from '../components/ui/Foto.astro';
import ParaQuien from '../components/sections/ParaQuien.astro';
import Metodologia from '../components/sections/Metodologia.astro';
import FAQ from '../components/sections/FAQ.astro';
import WhatsAppFloat from '../components/ui/WhatsAppFloat.astro';
import CookieBanner from '../components/ui/CookieBanner.astro';
import { SERVICIOS } from '../lib/servicios';
import { whatsappLink } from '../lib/whatsapp';
import { absoluteUrl, breadcrumbSchema } from '../lib/seo';

const path = '/servicios';
// Lista de servicios como ItemList: le dice a Google que esta página es el
// índice de las seis páginas de servicio, y las enlaza entre sí.
const listaSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Servicios de INSOLVA Group en Tierra del Fuego',
  itemListElement: SERVICIOS.map((serv, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: serv.nombre,
    url: absoluteUrl(`/${serv.slug}`),
  })),
};

const schemas = [listaSchema, breadcrumbSchema([{ name: 'Servicios', path }])];
---

<Layout
  title="Servicios de Seguridad Electrónica en Tierra del Fuego | INSOLVA Group"
  description="Cámaras de seguridad, alarmas, cerraduras digitales, domótica, redes WiFi y electricidad en Ushuaia, Río Grande y Tolhuin. Mirá cada servicio y pedí presupuesto por WhatsApp."
  path={path}
  keywords="servicios de seguridad electrónica Ushuaia, empresa de seguridad Tierra del Fuego, cámaras alarmas cerraduras Ushuaia, instalaciones eléctricas y domótica Ushuaia"
  schemas={schemas}
>
  <Header heroOscuro />

  <main>
    <PageHero
      eyebrow="SERVICIOS · TIERRA DEL FUEGO"
      titulo="Todo lo que"
      destacado="instalamos."
      lead="Seguridad electrónica, automatización, redes y electricidad para casas, comercios y obras de Ushuaia, Río Grande y Tolhuin. Elegí el servicio que necesitás y escribinos directo por WhatsApp."
      trail={[{ name: 'Servicios', path }]}
    />

    <!-- ── LOS SEIS SERVICIOS ───────────────────────────────── -->
    <section class="section section-light">
      <div class="wrap">
        <ul class="grid gap-x-12">
          {SERVICIOS.map((serv, i) => {
            const wa = whatsappLink({ message: serv.waMessage });
            return (
              <li class={`reveal reveal-delay-${(i % 3) + 1} border-t border-[#11140F]/12 last:border-b`}>
                <article class="grid gap-6 py-10 md:grid-cols-[auto_1.4fr_1fr] md:items-center md:gap-10">

                  <a href={`/${serv.slug}/`} class="block w-full md:w-52 shrink-0" tabindex="-1" aria-hidden="true">
                    <Foto src={serv.hero.src} alt="" width={400} height={300} class="photo-zoom" />
                  </a>

                  <div>
                    <span class="num-index mb-3 !text-[2rem]" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                    <h2 class="heading-sub text-[#11140F] mb-3">
                      <a href={`/${serv.slug}/`} class="hover:text-[#4F7D22] transition-colors">{serv.nav}</a>
                    </h2>
                    <p class="body-text max-w-md">{serv.resumen}</p>
                  </div>

                  <div class="flex flex-wrap items-center gap-3 md:justify-end">
                    <a href={wa} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                      </svg>
                      WhatsApp
                    </a>
                    <a href={`/${serv.slug}/`} class="link-arrow">
                      Ver detalle <span aria-hidden="true">→</span>
                    </a>
                  </div>

                </article>
              </li>
            );
          })}
        </ul>
      </div>
    </section>

    <ParaQuien />
    <Metodologia />
    <FAQ />

    <!-- ── CTA ──────────────────────────────────────────────── -->
    <section class="section section-void on-dark">
      <div class="wrap max-w-3xl">
        <div class="reveal">
          <h2 class="heading-display text-white">¿No sabés<br />por dónde empezar?</h2>
          <p class="body-lead mt-6">
            Contanos qué tenés y qué te preocupa. Vamos, miramos el lugar y te
            decimos qué conviene hacer primero, aunque no sea todo junto.
          </p>
          <div class="mt-9">
            <a
              href={whatsappLink({ source: 'contacto' })}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary"
            >
              Hablar con INSOLVA
            </a>
          </div>
        </div>
      </div>
    </section>

  </main>

  <Footer />
  <WhatsAppFloat />
  <CookieBanner />
</Layout>
