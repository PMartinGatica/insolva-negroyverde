---
import '../styles/global.css';
import { BRAND } from '../lib/constants';
import { absoluteUrl, organizationSchema } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  /** Path interno de ESTA página ("/camaras-de-seguridad-tierra-del-fuego"). */
  path?: string;
  keywords?: string;
  ogImage?: string;
  /** JSON-LD extra de la página (Service, FAQPage, BreadcrumbList…). */
  schemas?: object[];
}

const {
  title = `Cámaras, Alarmas, Redes y Electricista en Ushuaia | ${BRAND.name}`,
  description = BRAND.description,
  path = '/',
  keywords = 'cámaras de seguridad en Ushuaia, instalación de cámaras Ushuaia, empresa de alarmas en Ushuaia, alarmas para casa Ushuaia, empresa de redes en Ushuaia, redes WiFi Ushuaia, domótica en Ushuaia, automatización del hogar Ushuaia, casa inteligente Ushuaia, electricista en Ushuaia, instalaciones eléctricas Ushuaia, cerraduras digitales Ushuaia, seguridad electrónica Tierra del Fuego',
  ogImage = '/og-image.png',
  schemas = [],
} = Astro.props;

// Cada página declara su propio canonical. Antes estaba fijo en la home, lo que
// le decía a Google que toda página interna era un duplicado de "/".
const canonicalUrl = absoluteUrl(path);

// La ficha de empresa va en todas las páginas con el mismo @id; los schemas de
// la página se cuelgan de ella.
const todosLosSchemas = [organizationSchema(), ...schemas];
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Marca que el JS arrancó. Las animaciones de entrada solo ocultan
         contenido si esta clase está: sin JS, la página se ve completa. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content="index, follow, max-image-preview:large" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={BRAND.name} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteUrl(ogImage)} />
    <meta property="og:locale" content="es_AR" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteUrl(ogImage)} />

    <!-- Geo: refuerza a la empresa como prestadora de Tierra del Fuego -->
    <meta name="geo.region" content="AR-V" />
    <meta name="geo.placename" content="Ushuaia, Tierra del Fuego" />

    <!-- Tipografías. Van acá y no como @import en el CSS: ahí el optimizador
         las descartaba por quedar después de otras reglas. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Barlow+Condensed:wght@600;800&display=swap"
    />
    <!-- La display de marca es local: se precarga para que el titular del hero
         no aparezca primero con la tipografía de fallback. -->
    <link
      rel="preload"
      href="/fonts/BlauerNue-Heavy.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />

    <!-- Favicon. Google pide un cuadrado de tamaño múltiplo de 48 (48/96/144): el
         isotipo SVG mide 888x1075, o sea vertical, así que no le servía y mostraba
         su marcador genérico. Los PNG y el .ico salen de scripts/build-favicons.mjs. -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="icon" type="image/png" sizes="144x144" href="/favicon-144.png" />
    <!-- El SVG queda último, para que lo prefieran los navegadores que lo soportan. -->
    <link rel="icon" type="image/svg+xml" sizes="any" href="/isotipo-verde.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Schema.org -->
    {todosLosSchemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body>
    <slot />

    <script>
      // Intersection Observer para animaciones reveal
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12 }
      );

      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));

      // Nav scroll effect. El color del logo y de los links según el hero lo
      // resuelve el CSS a partir de .nav-scrolled + [data-hero-oscuro].
      const nav = document.getElementById('main-nav');
      function updateNav() {
        nav?.classList.toggle('nav-scrolled', window.scrollY > 40);
      }
      updateNav();
      window.addEventListener('scroll', updateNav, { passive: true });

      // WhatsApp float: aparece tras 200px de scroll
      const waFloat = document.getElementById('wa-float');
      window.addEventListener('scroll', () => {
        const visible = window.scrollY > 200;
        waFloat?.classList.toggle('opacity-0', !visible);
        waFloat?.classList.toggle('pointer-events-none', !visible);
        waFloat?.classList.toggle('opacity-100', visible);
      }, { passive: true });
    </script>
  </body>
</html>
